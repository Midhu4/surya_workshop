            "raw_output": "/home/jovyan/surya_workshop/downstream_apps/solar_event/.ipynb_checkpoints/0_dataset_dataloader_template-checkpoint.ipynb\n/home/jovyan/surya_workshop/downstream_apps/solar_event/.ipynb_checkpoints/1_baseline_template-checkpoint.ipynb\n/home/jovyan/surya_workshop/downstream_apps/solar_event/.ipynb_checkpoints/A_shapes_and_broadcasting-checkpoint.ipynb\n/home/jovyan/surya_workshop/downstream_apps/solar_event/0_dataset_dataloader_template.ipynb\n/home/jovyan/surya_workshop/downstream_apps/solar_event/1_baseline_template.ipynb\n/home/jovyan/surya_workshop/downstream_apps/solar_event/2_finetune_template_1D.ipynb\n/home/jovyan/surya_workshop/downstream_apps/solar_event/3_finetune_template_1D.py\n/home/jovyan/surya_workshop/downstream_apps/solar_event/ADAPTING.md\n/home/jovyan/surya_workshop/downstream_apps/solar_event/A_shapes_and_broadcasting.ipynb\n/home/jovyan/surya_workshop/downstream_apps/solar_event/__pycache__/configs.cpython-312.pyc\n/home/jovyan/surya_workshop/downstream_apps/solar_event/assets/.gitkeep\n/home/jovyan/surya_workshop/downstream_apps/solar_event/assets/scalers.yaml\n/home/jovyan/surya_workshop/downstream_apps/solar_event/baseline.chat\n/home/jovyan/surya_workshop/downstream_apps/solar_event/configs.py\n/home/jovyan/surya_workshop/downstream_apps/solar_event/configs/config_script.yaml\n/home/jovyan/surya_workshop/downstream_apps/solar_event/data/.ipynb_checkpoints/hek_flare_catalog-checkpoint.csv\n/home/jovyan/surya_workshop/downstream_apps/solar_event/data/.ipynb_checkpoints/solar_event_data-checkpoint.csv\n/home/jovyan/surya_workshop/downstream_apps/solar_event/data/.ipynb_checkpoints/solar_event_data2-checkpoint.csv\n/home/jovyan/surya_workshop/downstream_apps/solar_event/data/hek_flare_catalog.csv\n/home/jovyan/surya_workshop/downstream_apps/solar_event/data/solar_event_data.csv\n/home/jovyan/surya_workshop/downstream_apps/solar_event/data/solar_event_data2.csv\n/home/jovyan/surya_workshop/downstream_apps/solar_event/datasets/__init__.py\n/home/jovyan/surya_workshop/downstream_apps/solar_event/datasets/__pycache__/__init__.cpython-312.pyc\n/home/jovyan/surya_workshop/downstream_apps/solar_event/datasets/__pycache__/solar_event_dataset.cpython-312.pyc\n/home/jovyan/surya_workshop/downstream_apps/solar_event/datasets/solar_event_dataset.py\n/home/jovyan/surya_workshop/downstream_apps/solar_event/download_scalers.sh\n/home/jovyan/surya_workshop/downstream_apps/solar_event/download_scalers_and_weights.sh\n/home/jovyan/surya_workshop/downstream_apps/solar_event/lightning_modules/__init__.py\n/home/jovyan/surya_workshop/downstream_apps/solar_event/lightning_modules/pl_simple_baseline.py\n/home/jovyan/surya_workshop/downstream_apps/solar_event/logs/data/20260914T194729Z_000_data_train_5616.log\n/home/jovyan/surya_workshop/downstream_apps/solar_event/logs/data/20260915T180343Z_000_data_train_658.log\n/home/jovyan/surya_workshop/downstream_apps/solar_event/logs/data/20260915T182532Z_000_data_train_1482.log\n/home/jovyan/surya_workshop/downstream_apps/solar_event/logs/data/20260915T182532Z_000_data_train_1499.log\n/home/jovyan/surya_workshop/downstream_apps/solar_event/logs/data/20260915T182532Z_000_data_train_1509.log\n/home/jovyan/surya_workshop/downstream_apps/solar_event/logs/data/20260915T182747Z_000_data_train_225.log\n/home/jovyan/surya_workshop/downstream_apps/solar_event/logs/data/20260915T182747Z_000_data_train_235.log\n/home/jovyan/surya_workshop/downstream_apps/solar_event/logs/data/20260915T182747Z_000_data_train_245.log\n/home/jovyan/surya_workshop/downstream_apps/solar_event/logs/data/20260915T183457Z_000_data_train_292.log\n/home/jovyan/surya_workshop/downstream_apps/solar_event/logs/data/20260915T183457Z_000_data_train_302.log\n/home/jovyan/surya_workshop/downstream_apps/solar_event/logs/data/20260915T183457Z_000_data_train_312.log\n/home/jovyan/surya_workshop/downstream_apps/solar_event/metrics/__init__.py\n/home/jovyan/surya_workshop/downstream_apps/solar_event/metrics/template_metrics.py\n/home/jovyan/surya_workshop/downstream_apps/solar_event/models/__init__.py\n/home/jovyan/surya_workshop/downstream_apps/solar_event/models/simple_baseline.py\n/home/jovyan/surya_workshop/downstream_apps/solar_event/understanding dataloaders.chat",
