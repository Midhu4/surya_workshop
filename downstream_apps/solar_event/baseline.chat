            "locations": [
              "/home/jovyan/surya_workshop/downstream_apps/solar_event/datasets/solar_event_dataset.py"
            ],
            "raw_output": "1\timport numpy as np\n2\timport pandas as pd\n3\tfrom typing import Callable, Literal\n4\tfrom workshop_infrastructure.datasets.helio import HelioNetCDFDataset\n5\t\n6\t\n7\tclass solar_Dataset(HelioNetCDFDataset):\n8\t    \"\"\"\n9\t    Template child class of HelioNetCDFDataset showing how to build a downstream dataset.\n10\t    Extends the base class with a flare intensity label aligned to the Surya index.\n11\t\n12\t    All ``HelioNetCDFDataset`` keyword arguments (``index_path``, ``scalers``, ``channels``,\n13\t    ``s3_cache_dir``, etc.) are accepted via ``**kwargs`` and forwarded to the base class.\n14\t    ``load_forecast_frames`` defaults to ``False`` here (flare forecasting supplies its own\n15\t    labels, so future Surya frames are never fetched); pass it explicitly to override.\n16\t\n17\t    Additional Args:\n18\t        return_surya_stack: If True (default), include the Surya image stack in the returned dict.\n19\t            Set to False to return only the flare intensity label (useful for label inspection).\n20\t        max_number_of_samples: Cap the dataset length at this value. Useful for quick experiments.\n21\t        ds_solar_event_path: Path to the downstream flare intensity CSV index.\n22\t        ds_time_column: Column name in the flare index to use as the event timestamp.\n23\t        ds_time_tolerance: Maximum allowed time offset when matching Surya and DS indices\n24\t            (e.g., ``\"15min\"``). Unmatched entries are dropped.\n25\t        ds_match_direction: Merge direction passed to ``pd.merge_asof``. Use ``\"forward\"``\n26\t            for causal prediction (predict flares from prior solar state).\n27\t\n28\t    Raises:\n29\t        ValueError: If ``ds_flare_index_path`` is not provided, or if no overlap exists\n30\t            between the Surya and DS indices within the specified tolerance.\n31\t    \"\"\"\n32\t\n33\t    def __init__(\n34\t        self,\n35\t        # Downstream-specific parameters\n36\t        return_surya_stack: bool = True,\n37\t        max_number_of_samples: int | None = None,\n38\t        ds_flare_index_path: str | None = None,\n39\t        ds_time_column: str | None = None,\n40\t        ds_time_tolerance: str | None = None,\n41\t        ds_match_direction: Literal[\"forward\", \"backward\", \"nearest\"] = \"forward\",\n42\t        # All HelioNetCDFDataset parameters (index_path, scalers, channels, s3_*, etc.)\n43\t        **kwargs,\n44\t    ):\n45\t        if ds_match_direction not in [\"forward\", \"backward\", \"nearest\"]:\n46\t            raise ValueError(\"ds_match_direction must be one of 'forward', 'backward', or 'nearest'\")\n47\t\n48\t        # load_forecast_frames defaults to False here: flare forecasting supplies its\n49\t        # own labels, so future Surya frames never need to be fetched from disk/S3.\n50\t        kwargs.setdefault(\"load_forecast_frames\", False)\n51\t        super().__init__(**kwargs)\n52\t\n53\t        self.return_surya_stack = return_surya_stack\n54\t\n55\t        # Load ds index and find intersection with Surya index\n56\t        if ds_flare_index_path is not None:\n57\t            self.ds_index = pd.read_csv(ds_flare_index_path)\n58\t        else:\n59\t            raise ValueError(\"ds_flare_index_path must be provided for solar_Dataset\")\n60\t\n61\t        self.ds_index[\"ds_index\"] = pd.to_datetime(\n62\t            self.ds_index[ds_time_column]\n63\t        ).values.astype(\"datetime64[ns]\")\n64\t        self.ds_index.sort_values(\"ds_index\", inplace=True)\n65\t\n66\t        # Create Surya valid indices and find closest match to DS index\n67\t        self.df_valid_indices = pd.DataFrame(\n68\t            {\"valid_indices\": self.valid_indices}\n69\t        ).sort_values(\"valid_indices\")\n70\t        self.df_valid_indices = pd.merge_asof(\n71\t            self.df_valid_indices,\n72\t            self.ds_index,\n73\t            right_on=\"ds_index\",\n74\t            left_on=\"valid_indices\",\n75\t            direction=ds_match_direction,\n76\t        )\n77\t        # Remove duplicates keeping closest match\n78\t        self.df_valid_indices[\"index_delta\"] = np.abs(\n79\t            self.df_valid_indices[\"valid_indices\"] - self.df_valid_indices[\"ds_index\"]\n80\t        )\n81\t        self.df_valid_indices = self.df_valid_indices.sort_values(\n82\t            [\"ds_index\", \"index_delta\"]\n83\t        )\n84\t        self.df_valid_indices.drop_duplicates(\n85\t            subset=\"ds_index\", keep=\"first\", inplace=True\n86\t        )\n87\t        # Enforce a maximum time tolerance for matches\n88\t        if ds_time_tolerance is not None:\n89\t            self.df_valid_indices = self.df_valid_indices.loc[\n90\t                self.df_valid_indices[\"index_delta\"] <= pd.Timedelta(ds_time_tolerance),\n91\t                :,\n92\t            ]\n93\t            if len(self.df_valid_indices) == 0:\n94\t                raise ValueError(\"No intersection between Surya and DS indices\")\n95\t\n96\t        # Override valid indices variables to reflect matches between Surya and DS\n97\t        self.valid_indices = [\n98\t            pd.Timestamp(date) for date in self.df_valid_indices[\"valid_indices\"]\n99\t        ]\n100\t        self.adjusted_length = len(self.valid_indices)\n101\t        self.df_valid_indices.set_index(\"valid_indices\", inplace=True)\n102\t\n103\t        if max_number_of_samples is not None and max_number_of_samples < self.adjusted_length:\n104\t            self.valid_indices = self.valid_indices[:max_number_of_samples]\n105\t            self.df_valid_indices = self.df_valid_indices.iloc[:max_number_of_samples]\n106\t            self.adjusted_length = max_number_of_samples\n107\t\n108\t    def __len__(self):\n109\t        return self.adjusted_length\n110\t\n111\t    def __getitem__(self, idx: int) -> dict:\n112\t        \"\"\"\n113\t        Args:\n114\t            idx: Dataset index.\n115\t\n116\t        Returns:\n117\t            Dictionary containing:\n118\t                forecast (np.float32): Normalized log10 flare intensity label.\n119\t                ds_index (str): ISO-format timestamp from the flare index.\n120\t            When ``return_surya_stack=True``, also includes all keys from\n121\t            ``HelioNetCDFDataset.__getitem__`` (ts, time_delta_input, lead_time_delta, etc.).\n122\t        \"\"\"\n123\t        sample = super().__getitem__(idx=idx) if self.return_surya_stack else {}\n124\t        sample[\"forecast\"] = self.df_valid_indices.iloc[idx][\"Solar_Event_Occurrence\"].astype(np.float32)\n125\t        sample[\"ds_index\"] = self.df_valid_indices[\"ds_index\"].iloc[idx].isoformat()\n126\t        return sample\n127\t"
          },
