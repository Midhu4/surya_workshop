    {
      "body": "",
      "raw_time": false,
      "id": "564c6963-3c26-432a-9011-27fff61273b2",
      "time": 1789413982.4959888,
      "mentions": [],
      "sender": "jupyter-ai-personas::jupyter_ai_acp_client::ClaudeAcpPersona",
      "type": "msg",
      "metadata": {
        "tool_calls": [
          {
            "kind": "read",
            "status": "completed",
            "raw_input": {
              "file_path": "/home/jovyan/surya_workshop/downstream_apps/solar_event/datasets/solar_event_dataset.py"
            },
            "tool_call_id": "toolu_bdrk_01ERHpHFzSFZ8eQ5Pr4oceyW",
            "raw_output": "1\timport numpy as np\n2\timport pandas as pd\n3\tfrom typing import Callable, Literal\n4\tfrom workshop_infrastructure.datasets.helio import HelioNetCDFDataset\n5\t\n6\t\n7\tclass solar_Dataset(HelioNetCDFDataset):\n8\t    \"\"\"\n9\t    Template child class of HelioNetCDFDataset showing how to build a downstream dataset.\n10\t    Extends the base class with a flare intensity label aligned to the Surya index.\n11\t\n12\t    All ``HelioNetCDFDataset`` keyword arguments (``index_path``, ``scalers``, ``channels``,\n13\t    ``s3_cache_dir``, etc.) are accepted via ``**kwargs`` and forwarded to the base class.\n14\t    ``load_forecast_frames`` defaults to ``False`` here (flare forecasting supplies its own\n15\t    labels, so future Surya frames are never fetched); pass it explicitly to override.\n16\t\n17\t    Additional Args:\n18\t        return_surya_stack: If True (default), include the Surya image stack in the returned dict.\n19\t            Set to False to return only the flare intensity label (useful for label inspection).\n20\t        max_number_of_samples: Cap the dataset length at this value. Useful for quick experiments.\n21\t        label_transform: Optional callable applied to the ``intensity`` column of the flare index\n22\t            to produce the ``normalized_intensity`` label. Signature:\n23\t            ``(series: pd.Series) -> pd.Series``.  If ``None``, the raw intensity values are\n24\t            used as-is. Define this at the call site (e.g., in ``build_datasets()``) to keep\n25\t            normalization logic out of the dataset class.\n26\t        ds_solar_event_path: Path to the downstream flare intensity CSV index.\n27\t        ds_time_column: Column name in the flare index to use as the event timestamp.\n28\t        ds_time_tolerance: Maximum allowed time offset when matching Surya and DS indices\n29\t            (e.g., ``\"15min\"``). Unmatched entries are dropped.\n30\t        ds_match_direction: Merge direction passed to ``pd.merge_asof``. Use ``\"forward\"``\n31\t            for causal prediction (predict flares from prior solar state).\n32\t\n33\t    Raises:\n34\t        ValueError: If ``ds_flare_index_path`` is not provided, or if no overlap exists\n35\t            between the Surya and DS indices within the specified tolerance.\n36\t    \"\"\"\n37\t\n38\t    def __init__(\n39\t        self,\n40\t        # Downstream-specific parameters\n41\t        return_surya_stack: bool = True,\n42\t        max_number_of_samples: int | None = None,\n43\t        ds_flare_index_path: str | None = None,\n44\t        ds_time_column: str | None = None,\n45\t        ds_time_tolerance: str | None = None,\n46\t        ds_match_direction: Literal[\"forward\", \"backward\", \"nearest\"] = \"forward\",\n47\t        # All HelioNetCDFDataset parameters (index_path, scalers, channels, s3_*, etc.)\n48\t        **kwargs,\n49\t    ):\n50\t        if ds_match_direction not in [\"forward\", \"backward\", \"nearest\"]:\n51\t            raise ValueError(\"ds_match_direction must be one of 'forward', 'backward', or 'nearest'\")\n52\t\n53\t        # load_forecast_frames defaults to False here: flare forecasting supplies its\n54\t        # own labels, so future Surya frames never need to be fetched from disk/S3.\n55\t        kwargs.setdefault(\"load_forecast_frames\", False)\n56\t        super().__init__(**kwargs)\n57\t\n58\t        self.return_surya_stack = return_surya_stack\n59\t\n60\t        # Load ds index and find intersection with Surya index\n61\t        if ds_flare_index_path is not None:\n62\t            self.ds_index = pd.read_csv(ds_flare_index_path)\n63\t        else:\n64\t            raise ValueError(\"ds_flare_index_path must be provided for solar_Dataset\")\n65\t\n66\t        self.ds_index[\"ds_index\"] = pd.to_datetime(\n67\t            self.ds_index[ds_time_column]\n68\t        ).values.astype(\"datetime64[ns]\")\n69\t        self.ds_index.sort_values(\"ds_index\", inplace=True)\n70\t\n71\t        \"\"\"# Apply label transform if provided; otherwise use raw intensity values.\n72\t        if label_transform is not None:\n73\t            self.ds_index[\"normalized_intensity\"] = label_transform(self.ds_index[\"intensity\"])\n74\t        else:\n75\t            self.ds_index[\"normalized_intensity\"] = self.ds_index[\"intensity\"]\"\"\"\n76\t\n77\t        # Adding the event occurrence data\n78\t        self\n79\t\n80\t        # Create Surya valid indices and find closest match to DS index\n81\t        self.df_valid_indices = pd.DataFrame(\n82\t            {\"valid_indices\": self.valid_indices}\n83\t        ).sort_values(\"valid_indices\")\n84\t        self.df_valid_indices = pd.merge_asof(\n85\t            self.df_valid_indices,\n86\t            self.ds_index,\n87\t            right_on=\"ds_index\",\n88\t            left_on=\"valid_indices\",\n89\t            direction=ds_match_direction,\n90\t        )\n91\t        # Remove duplicates keeping closest match\n92\t        self.df_valid_indices[\"index_delta\"] = np.abs(\n93\t            self.df_valid_indices[\"valid_indices\"] - self.df_valid_indices[\"ds_index\"]\n94\t        )\n95\t        self.df_valid_indices = self.df_valid_indices.sort_values(\n96\t            [\"ds_index\", \"index_delta\"]\n97\t        )\n98\t        self.df_valid_indices.drop_duplicates(\n99\t            subset=\"ds_index\", keep=\"first\", inplace=True\n100\t        )\n101\t        # Enforce a maximum time tolerance for matches\n102\t        if ds_time_tolerance is not None:\n103\t            self.df_valid_indices = self.df_valid_indices.loc[\n104\t                self.df_valid_indices[\"index_delta\"] <= pd.Timedelta(ds_time_tolerance),\n105\t                :,\n106\t            ]\n107\t            if len(self.df_valid_indices) == 0:\n108\t                raise ValueError(\"No intersection between Surya and DS indices\")\n109\t\n110\t        # Override valid indices variables to reflect matches between Surya and DS\n111\t        self.valid_indices = [\n112\t            pd.Timestamp(date) for date in self.df_valid_indices[\"valid_indices\"]\n113\t        ]\n114\t        self.adjusted_length = len(self.valid_indices)\n115\t        self.df_valid_indices.set_index(\"valid_indices\", inplace=True)\n116\t\n117\t        if max_number_of_samples is not None and max_number_of_samples < self.adjusted_length:\n118\t            self.valid_indices = self.valid_indices[:max_number_of_samples]\n119\t            self.df_valid_indices = self.df_valid_indices.iloc[:max_number_of_samples]\n120\t            self.adjusted_length = max_number_of_samples\n121\t\n122\t    def __len__(self):\n123\t        return self.adjusted_length\n124\t\n125\t    def __getitem__(self, idx: int) -> dict:\n126\t        \"\"\"\n127\t        Args:\n128\t            idx: Dataset index.\n129\t\n130\t        Returns:\n131\t            Dictionary containing:\n132\t                forecast (np.float32): Normalized log10 flare intensity label.\n133\t                ds_index (str): ISO-format timestamp from the flare index.\n134\t            When ``return_surya_stack=True``, also includes all keys from\n135\t            ``HelioNetCDFDataset.__getitem__`` (ts, time_delta_input, lead_time_delta, etc.).\n136\t        \"\"\"\n137\t        sample = super().__getitem__(idx=idx) if self.return_surya_stack else {}\n138\t        sample[\"forecast\"] = self.df_valid_indices.iloc[idx][\"normalized_intensity\"].astype(np.float32)\n139\t        sample[\"ds_index\"] = self.df_valid_indices[\"ds_index\"].iloc[idx].isoformat()\n140\t        return sample\n141\t",
