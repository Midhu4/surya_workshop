          {
            "raw_input": {
              "command": "cd /home/jovyan/surya_workshop && sed -n '1,80p' workshop_infrastructure/datasets/builders.py"
            },
            "selected_option_id": "allow-once",
            "session_id": "fb0391f7-5900-46ee-8ab5-709372dc9d24",
            "permission_options": [
              {
                "name": "Yes",
