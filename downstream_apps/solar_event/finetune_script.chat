            "raw_output": "100\t    if scalers is None:\n101\t        scalers = build_scalers(info=cfg.data.scalers_path)\n102\t\n103\t    common = {**_base_dataset_kwargs(cfg, scalers), **task_kwargs}\n104\t\n105\t    train_dataset = dataset_cls(index_path=cfg.data.train_data_path, phase=\"train\", **common)\n106\t    val_dataset = dataset_cls(index_path=cfg.data.valid_data_path, phase=\"val\", **common)\n107\t    return train_dataset, val_dataset\n108\t\n109\t\n110\tdef build_helio_dataloaders(\n111\t    cfg,\n112\t    dataset_cls: Type[Dataset],\n113\t    scalers: Any = None,\n114\t    num_workers: int | None = None,\n115\t    seed: int | None = None,\n116\t    **task_kwargs,\n117\t) -> Tuple[DataLoader, DataLoader]:\n118\t    \"\"\"Build the train and validation DataLoaders described by ``cfg``.\n119\t\n120\t    Args:\n121\t        cfg: A ``TrainingConfig`` from ``load_config()``.\n122\t        dataset_cls: ``HelioNetCDFDataset`` or a subclass of it.\n123\t        scalers: Normalization statistics; built from the config if omitted.\n124\t        num_workers: Override for ``cfg.num_workers`` (useful in notebooks, where fewer\n125\t            workers start faster).\n126\t        seed: Seed for the shuffle order and the per-worker RNGs. Defaults to ``cfg.seed``.\n127\t            Pinning it explicitly is what makes the epoch order depend only on the config:\n128\t            a bare ``shuffle=True`` seeds its sampler from whatever the global torch RNG\n129\t            state happens to be when the iterator is created, so anything that consumes\n130\t            RNG earlier in the program silently reshuffles the data.\n131\t        **task_kwargs: Extra keyword arguments forwarded to ``dataset_cls``.\n132\t\n133\t    Returns:\n134\t        ``(train_loader, val_loader)``. Only the training loader shuffles.\n135\t    \"\"\"\n136\t    train_dataset, val_dataset = build_helio_datasets(\n137\t        cfg, dataset_cls, scalers=scalers, **task_kwargs\n138\t    )\n139\t\n140\t    workers = cfg.num_workers if num_workers is None else num_workers\n141\t    base_seed = cfg.seed if seed is None else seed\n142\t\n143\t    loader_kwargs = dict(\n144\t        batch_size=cfg.batch_size,\n145\t        num_workers=workers,\n146\t        pin_memory=True,\n147\t        drop_last=True,\n148\t    )\n149\t    if workers > 0:\n150\t        # \"spawn\": the dataset holds an s3fs/boto3 handle that does not survive fork.\n151\t        # Both of these are rejected outright when num_workers == 0.\n152\t        loader_kwargs[\"multiprocessing_context\"] = \"spawn\"\n153\t        loader_kwargs[\"persistent_workers\"] = True\n154\t        loader_kwargs[\"worker_init_fn\"] = partial(_seed_worker, base_seed=base_seed)\n155\t\n156\t    # An explicit generator makes the shuffle a function of the seed alone, rather than\n157\t    # of the global RNG state at the moment the iterator happens to be created.\n158\t    shuffle_generator = torch.Generator()\n159\t    shuffle_generator.manual_seed(base_seed)"
