            "raw_output": "182:        \"train_data_path\",\n183:        \"valid_data_path\",\n189:    train_data_path: str\n190:    valid_data_path: str\n213:    max_samples: Optional[int] = None\n246:    # data order is pinned, so changing the seed is how you get a genuinely different run.\n247:    seed: int = 42\n268:        # A quoted seed in YAML (\"42\") would otherwise reach torch.manual_seed as a str\n270:        if isinstance(self.seed, bool) or not isinstance(self.seed, int):\n272:                f\"training.seed must be an integer, got {self.seed!r} \"\n273:                f\"({type(self.seed).__name__}). Write it unquoted in the YAML, e.g. seed: 42.\"\n423:        seed=training.get(\"seed\", 42),\n437:    \"learning_rate\", \"max_epochs\", \"batch_size\", \"num_workers\", \"seed\", \"deterministic\",\nShell cwd was reset to /home/jovyan/surya_workshop/downstream_apps/solar_event",
