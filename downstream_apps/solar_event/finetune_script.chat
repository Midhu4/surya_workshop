            "raw_output": "330\t\n331\t\n332\tdef _resolve_path(value, config_dir: Path) -> str:\n333\t    \"\"\"Expand ``~``/``$VARS`` and anchor a relative path to the config file's directory.\"\"\"\n334\t    expanded = os.path.expandvars(os.path.expanduser(str(value)))\n335\t    if not os.path.isabs(expanded):\n336\t        expanded = str((config_dir / expanded).resolve())\n337\t    return expanded\n338\t\n339\t\n340\tdef _resolve_paths(data_cfg, config_dir: Path) -> None:\n341\t    \"\"\"Expand ``~``/env vars and resolve relative path fields against the config's directory.\"\"\"\n342\t    for name in getattr(type(data_cfg), \"PATH_FIELDS\", DataConfig.PATH_FIELDS):\n343\t        value = getattr(data_cfg, name, None)\n344\t        if value:\n345\t            setattr(data_cfg, name, _resolve_path(value, config_dir))\n346\t\n347\t    # s3_cache_dir is a scratch location, not a repo path. Precedence is\n348\t    # CLI flag > config value > $SURYA_WS_CACHE_DIR; expand ~ and $VARS, but never anchor\n349\t    # it to the config directory (that would put ~1 GB files inside the repo).\n350\t    cache_dir = getattr(data_cfg, \"s3_cache_dir\", None) or os.environ.get(S3_CACHE_DIR_ENV_VAR)\n351\t    if cache_dir:\n352\t        data_cfg.s3_cache_dir = os.path.expandvars(os.path.expanduser(str(cache_dir)))\n353\t\n354\t\n355\tdef load_config(\n356\t    path: Union[str, Path],\n357\t    data_cls: type = DataConfig,\n358\t) -> TrainingConfig:\n359\t    \"\"\"Parse a run config YAML into a typed ``TrainingConfig``.",
