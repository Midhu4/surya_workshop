      "id": "428697ad-861c-4432-ba21-a118d46fe2ad",
      "metadata": {
        "tool_calls": [
          {
            "raw_output": "1\t#!/usr/bin/env python3\n2\t\"\"\"\n3\tRunnable finetuning script derived from `2_finetune_template_1D.ipynb`.\n4\t\n5\tDesign goals\n6\t- Config-driven: all hyperparameters live in config_script.yaml\n7\t- Minimal CLI: --config plus a handful of per-run overrides\n8\t- Multi-GPU capable (DDP) when run as a script\n9\t\n10\tAssumptions\n11\t- Assets (`scalers.yaml` + model weights) are downloaded automatically on first run.\n12\t- You run this script from the repo root and specify devices via CUDA_VISIBLE_DEVICES:\n13\t    CUDA_VISIBLE_DEVICES=0,1 python -m downstream_apps.solar_event.3_finetune_template_1D \\\n14\t        --config downstream_apps/solar_event/configs/config_script.yaml\n15\t\n16\tAll parameters live in the YAML. The CLI overrides only what genuinely varies between\n17\truns of the same config: --max-epochs and --batch-size (sweeps), --s3-cache-dir\n18\t(per-machine scratch) and --deterministic (reproducibility, off by default for speed).\n19\tEverything else is a config edit.\n20\t\n21\tForking this script: build_datasets() and build_model() are the only two functions with\n22\ttask-specific content. build_trainer() and main() should need no changes.\n23\t\"\"\"\n24\t\n25\tfrom __future__ import annotations\n26\t\n27\timport argparse\n28\timport os\n29\t\n30\t# Must be set BEFORE torch is imported: cuBLAS reads this once, when it initializes, so\n31\t# setting it later has no effect. Deterministic cuBLAS on CUDA >= 10.2 requires it, and\n32\t# without it every run under training.deterministic warns (or raises, when set to true).\n33\t# setdefault so a deliberate \":16:8\" (smaller workspace, slightly slower) is respected.\n34\tos.environ.setdefault(\"CUBLAS_WORKSPACE_CONFIG\", \":4096:8\")\n35\t\n36\tfrom pathlib import Path\n37\tfrom typing import Tuple\n38\t\n39\timport torch\n40\timport lightning as L\n41\tfrom lightning.pytorch.callbacks import ModelCheckpoint\n42\tfrom lightning.pytorch.loggers import CSVLogger, WandbLogger\n43\tfrom torch.utils.data import DataLoader\n44\t\n45\tfrom downstream_apps.solar_event.configs import TrainingConfig, solar_event_config\n46\tfrom downstream_apps.solar_event.datasets.solar_event_dataset import solar_Dataset\n47\tfrom downstream_apps.solar_event.lightning_modules.pl_simple_baseline import SolarEventLightningModule\n48\tfrom downstream_apps.solar_event.metrics.template_metrics import SolarEventMetrics\n49\tfrom workshop_infrastructure.assets import ensure_assets\n50\tfrom workshop_infrastructure.datasets.builders import build_helio_dataloaders\n51\tfrom workshop_infrastructure.utils import (\n52\t    apply_peft_lora,\n53\t    build_scalers,\n54\t    load_pretrained_weights,\n55\t    UploadBestCheckpointToS3,\n56\t)\n57\t\n58\tDEFAULT_CONFIG = Path(__file__).parent / \"configs\" / \"config_script.yaml\"\n59\t\n60\t# --deterministic accepts the same three tokens as the YAML key. argparse hands back a\n61\t# string, so the two boolean ones are mapped to real bools -- TrainingConfig validates\n62\t# against True/False/\"warn\", not against their spellings.\n63\t_DETERMINISTIC_CLI = {\"false\": False, \"warn\": \"warn\", \"true\": True}\n64\t\n65\t\n66\t# ---------------------------------------------------------------------------\n67\t# Build functions\n68\t# ---------------------------------------------------------------------------\n69\t\n70\tdef parse_args() -> argparse.Namespace:\n71\t    parser = argparse.ArgumentParser()\n72\t    parser.add_argument(\"--config\", type=str, default=str(DEFAULT_CONFIG),\n73\t                        help=\"Path to the run config YAML (default: this app's config_script.yaml).\")\n74\t    # Dev toggles: flip without editing the YAML\n75\t    parser.add_argument(\"--no-wandb\", action=\"store_true\",\n76\t                        help=\"Disable WandB logging (useful for local runs).\")\n77\t    parser.add_argument(\"--train_baseline\", action=\"store_true\",\n78\t                        help=\"Train the simple linear baseline instead of HelioSpectformer.\")\n79\t    # Per-job / per-machine overrides: vary across runs without touching the YAML\n80\t    parser.add_argument(\"--max-epochs\", type=int, default=None,\n81\t                        help=\"Override training.max_epochs from the config YAML.\")\n82\t    parser.add_argument(\"--batch-size\", type=int, default=None,\n83\t                        help=\"Override training.batch_size from the config YAML.\")\n84\t    parser.add_argument(\"--s3-cache-dir\", type=str, default=None,\n85\t                        help=\"Override data.s3_cache_dir (the local cache for S3 reads). \"\n86\t                             \"Handy when the same config runs on machines with different scratch.\")\n87\t    parser.add_argument(\"--deterministic\", choices=tuple(_DETERMINISTIC_CLI), default=None,\n88\t                        help=\"Override training.deterministic. The config default is 'false', \"\n89\t                             \"which trades reproducibility for roughly 20%% throughput. Pass \"\n90\t                             \"'warn' when you need to tell whether a change in your results came \"\n91\t                             \"from your edit or from run-to-run drift.\")\n92\t    return parser.parse_args()\n93\t\n94\t\n95\tdef build_datasets(cfg: TrainingConfig, scalers) -> Tuple[DataLoader, DataLoader]:\n96\t    \"\"\"Create train and validation DataLoaders from config.\n97\t\n98\t    Everything generic (channels, temporal sampling, S3 access, worker settings) is\n99\t    handled by build_helio_dataloaders(). Only the flare-specific arguments below are\n100\t    this app's business \u2014 when you fork the template, this is the list you replace.\n101\t\n102\t    ``scalers`` is built once in main() and shared with build_model(), so the two paths\n103\t    cannot end up with different normalization statistics.\n104\t    \"\"\"\n105\t    return build_helio_dataloaders(\n106\t        cfg,\n107\t        solar_Dataset,\n108\t        scalers=scalers,\n109\t        seed=cfg.seed,\n110\t        return_surya_stack=True,\n111\t        max_number_of_samples=cfg.data.max_samples,\n112\t        ds_flare_index_path=cfg.data.solar_event_path,\n113\t        ds_time_column=cfg.data.ds_time_column,\n114\t        ds_time_tolerance=cfg.data.ds_time_tolerance,\n115\t        ds_match_direction=cfg.data.ds_match_direction,\n116\t    )\n117\t\n118\t\n119\tdef build_model(cfg: TrainingConfig, scalers, train_baseline: bool = False) -> L.LightningModule:\n120\t    \"\"\"Instantiate the model and wrap it in a LightningModule.\n121\t\n122\t    ``scalers`` is only needed by the linear baseline, which consumes its inputs in\n123\t    signum-log space; the HelioSpectformer path works directly on normalized inputs.\n124\t    \"\"\"\n125\t    metrics = {\n126\t        train_loss_metrics : SolarEventMetrics(\"train_loss\")\n127\t        # val_loss is the quantity logged as \"val_loss\" and used to pick the best checkpoint.\n128\t        val_loss_metrics : SolarEventMetrics(\"val_loss\")\n129\t        train_evaluation_metrics : SolarEventMetrics(\"train_metrics\")\n130\t        # Reported only: val_metrics do NOT influence checkpoint selection.\n131\t        validation_evaluation_metrics : SolarEventMetrics(\"val_metrics\")\n132\t    }\n133\t\n134\t    if train_baseline:\n135\t        from functools import partial\n136\t        from downstream_apps.solar_event.models.simple_baseline import (\n137\t            IdentificationModel,\n138\t            destandardize_channels,\n139\t        )\n140\t        n_input_timestamps = cfg.model.time_embedding.time_dim\n141\t        n_channels = len(cfg.data.channels)\n142\t        model = IdentificationModel(n_input_timestamps * n_channels)\n143\t        preprocess_fn = partial(destandardize_channels, channel_order=cfg.data.channels, scalers=scalers)\n144\t        return SolarEventLightningModule(model, metrics, lr=cfg.learning_rate, batch_size=cfg.batch_size, preprocess_fn=preprocess_fn)\n145\t    else:\n146\t        from workshop_infrastructure.models.finetune_models import HelioSpectformer1D\n147\t        model = HelioSpectformer1D.from_config(\n148\t            cfg.model,\n149\t            num_outputs=1,\n150\t            dtype=cfg.dtype,\n151\t            use_latitude_in_learned_flow=cfg.use_latitude_in_learned_flow,\n152\t        )\n153\t        load_pretrained_weights(model, cfg.model.pretrained_path)\n154\t\n155\t        # Three fine-tuning regimes, selected from the model: section of the YAML:\n156\t        #   use_lora: true                        -> LoRA adapters (default)\n157\t        #   use_lora: false, freeze_backbone: true  -> linear probe (head only)\n158\t        #   use_lora: false, freeze_backbone: false -> full fine-tuning\n159\t        if cfg.model.freeze_backbone:\n160\t            for name, param in model.named_parameters():\n161\t                if name.startswith(\"backbone.\"):\n162\t                    param.requires_grad = False\n163\t        if cfg.model.use_lora:\n164\t            model = apply_peft_lora(model, cfg.model.lora_config)\n165\t\n166\t        _log_trainable_parameters(model)\n167\t\n168\t    return SolarEventLightningModule(model, metrics, lr=cfg.learning_rate, batch_size=cfg.batch_size)\n169\t\n170\t\n171\tdef _log_trainable_parameters(model) -> None:\n172\t    \"\"\"Print the trainable/total parameter counts, so the chosen regime is visible in the log.\"\"\"\n173\t    trainable = sum(p.numel() for p in model.parameters() if p.requires_grad)\n174\t    total = sum(p.numel() for p in model.parameters())\n175\t    pct = 100.0 * trainable / total if total else 0.0\n176\t    print(f\"[MODEL] Trainable parameters: {trainable:,} / {total:,} ({pct:.2f}%)\")\n177\t\n178\t\n179\tdef build_trainer(\n180\t    cfg: TrainingConfig,\n181\t    no_wandb: bool = False,\n182\t    max_epochs_override: int | None = None,\n183\t) -> Tuple[L.Trainer, ModelCheckpoint]:\n184\t    \"\"\"Configure loggers, callbacks, and the Lightning Trainer.\"\"\"\n185\t    max_epochs = max_epochs_override if max_epochs_override is not None else cfg.max_epochs\n186\t\n187\t    loggers = []\n188\t    if not no_wandb:\n189\t        loggers.append(WandbLogger(\n190\t            entity=cfg.wandb_entity,  # None = personal account; set in YAML for team runs\n191\t            project=cfg.wandb_project,\n192\t            name=cfg.job_id,\n193\t            log_model=False,\n194\t            save_dir=os.environ.get(\"TMPDIR\", \"./wandb/wandb_tmp\"),\n195\t        ))\n196\t    loggers.append(CSVLogger(\"runs\", name=cfg.job_id))\n197\t\n198\t    Path(cfg.output.ckpt_dir).mkdir(parents=True, exist_ok=True)\n199\t    checkpoint_cb = ModelCheckpoint(\n200\t        dirpath=cfg.output.ckpt_dir,\n201\t        filename=\"best-{epoch:02d}-{val_loss:.4f}\",\n202\t        monitor=\"val_loss\",\n203\t        mode=\"min\",\n204\t        save_top_k=1,\n205\t        save_last=False,\n206\t    )\n207\t    upload_cb = UploadBestCheckpointToS3(\n208\t        checkpoint_cb=checkpoint_cb,\n209\t        bucket=cfg.output.s3_bucket,\n210\t        prefix=cfg.output.s3_prefix,\n211\t        fixed_key_name=(cfg.output.s3_best_key or None),\n212\t    )\n213\t\n214\t    trainer = L.Trainer(\n215\t        max_epochs=max_epochs,\n216\t        accelerator=\"gpu\" if torch.cuda.is_available() else \"cpu\",\n217\t        devices=\"auto\",\n218\t        strategy=\"auto\",\n219\t        precision=\"bf16-mixed\" if torch.cuda.is_available() else \"32-true\",\n220\t        # Reproducibility. \"warn\" (the default) gives bit-identical runs wherever a\n221\t        # deterministic kernel exists and names the op where one does not, instead of\n222\t        # killing the run. benchmark is pinned rather than inherited: cuDNN autotuning\n223\t        # picks algorithms by timing, so leaving it on would reintroduce run-to-run drift.\n224\t        deterministic=cfg.deterministic,\n225\t        benchmark=False,\n226\t        logger=loggers,\n227\t        callbacks=[checkpoint_cb, upload_cb],\n228\t        log_every_n_steps=2,\n229\t    )\n230\t    return trainer, checkpoint_cb\n231\t\n232\t\n233\t# ---------------------------------------------------------------------------\n234\t# Entry point\n235\t# ---------------------------------------------------------------------------\n236\t\n237\tdef main() -> None:\n238\t    args = parse_args()\n239\t    torch.set_float32_matmul_precision(\"medium\")\n240\t\n241\t    cfg = solar_event_config(args.config)\n242\t    # Seeding comes after the config load, so the seed is a configured value rather than\n243\t    # a constant buried in the code. Seeds Python, NumPy and torch in this process;\n244\t    # workers=True extends it to DataLoader workers.\n245\t    L.seed_everything(cfg.seed, workers=True)\n246\t    if args.batch_size is not None:\n247\t        cfg.batch_size = args.batch_size\n248\t    if args.s3_cache_dir is not None:\n249\t        cfg.data.s3_cache_dir = args.s3_cache_dir\n250\t    if args.deterministic is not None:\n251\t        cfg.deterministic = _DETERMINISTIC_CLI[args.deterministic]\n252\t    # Fetch scalers, and the backbone weights unless we are training the baseline.\n253\t    ensure_assets(cfg, which=[\"scalers\"] if args.train_baseline else [\"scalers\", \"weights\"])\n254\t\n255\t    # Built once and shared: the dataset normalizes with these, and the linear baseline\n256\t    # de-standardizes with them. Two separate builds could silently disagree.\n257\t    scalers = build_scalers(info=cfg.data.scalers_path)\n258\t\n259\t    train_loader, val_loader = build_datasets(cfg, scalers)\n260\t    lit_model = build_model(cfg, scalers, train_baseline=args.train_baseline)\n261\t    trainer, checkpoint_cb = build_trainer(cfg, no_wandb=args.no_wandb, max_epochs_override=args.max_epochs)\n262\t\n263\t    trainer.fit(lit_model, train_loader, val_loader)\n264\t\n265\t    if checkpoint_cb.best_model_path:\n266\t        print(f\"[CKPT] Best checkpoint: {checkpoint_cb.best_model_path}\")\n267\t        if checkpoint_cb.best_model_score is not None:\n268\t            print(f\"[CKPT] Best val_loss: {float(checkpoint_cb.best_model_score):.6f}\")\n269\t    else:\n270\t        print(\"[CKPT] No best checkpoint was saved.\")\n271\t\n272\t\n273\tif __name__ == \"__main__\":\n274\t    main()\n275\t",
