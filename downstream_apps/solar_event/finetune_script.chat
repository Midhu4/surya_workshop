            },
            "raw_output": "output:\n  ckpt_dir: checkpoints   # Local directory for saved checkpoints\n\n  # S3 upload of best checkpoint (set s3_bucket to enable; all three are used together)\n  s3_bucket: null         # e.g. my-ml-artifacts\n  s3_prefix: \"\"           # Key prefix (folder) within the bucket, e.g. flare/exp_001\n  s3_best_key: best.ckpt  # Stable object name; always points to the latest best checkpoint\n\n\n# -----------------------------------------------------------------------------\n# Logging\n# -----------------------------------------------------------------------------\nlogging:\ntotal 1762620\ndrwxr-sr-x.  2 jovyan users       4096 Sep 17 18:19 .\ndrwxrwsr-x. 13 jovyan users       4096 Sep 17 17:52 ..\n-rw-r--r--.  1 jovyan users 1804909851 Sep 17 18:19 best-epoch=18-val_loss=0.6656.ckpt",
            "permission_status": "resolved",
            "selected_option_id": "allow-once",
            "session_id": "fb0391f7-5900-46ee-8ab5-709372dc9d24",
            "title": "sed -n '/^output:/,/^logging:/p' configs/config_script.yaml && ls -la  2>/dev/null",
