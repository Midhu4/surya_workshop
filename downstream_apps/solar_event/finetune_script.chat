            "raw_output": "1\timport numpy as np\n2\timport pandas as pd\n3\tfrom typing import Callable, Literal\n4\tfrom workshop_infrastructure.datasets.helio import HelioNetCDFDataset\n5\t\n6\t\n7\tclass solar_Dataset(HelioNetCDFDataset):\n8\t    \"\"\"\n9\t    Template child class of HelioNetCDFDataset showing how to build a downstream dataset.\n10\t    Extends the base class with a flare intensity label aligned to the Surya index.\n11\t\n12\t    All ``HelioNetCDFDataset`` keyword arguments (``index_path``, ``scalers``, ``channels``,\n13\t    ``s3_cache_dir``, etc.) are accepted via ``**kwargs`` and forwarded to the base class.\n14\t    ``load_forecast_frames`` defaults to ``False`` here (flare forecasting supplies its own\n15\t    labels, so future Surya frames are never fetched); pass it explicitly to override.\n16\t\n17\t    Additional Args:\n18\t        return_surya_stack: If True (default), include the Surya image stack in the returned dict.\n19\t            Set to False to return only the flare intensity label (useful for label inspection).\n20\t        max_number_of_samples: Cap the dataset length at this value. Useful for quick experiments.\n21\t        ds_solar_event_path: Path to the downstream flare intensity CSV index.\n22\t        ds_time_column: Column name in the flare index to use as the event timestamp.\n23\t        ds_time_tolerance: Maximum allowed time offset when matching Surya and DS indices\n24\t            (e.g., ``\"15min\"``). Unmatched entries are dropped.\n25\t        ds_match_direction: Merge direction passed to ``pd.merge_asof``. Use ``\"forward\"``\n26\t            for causal prediction (predict flares from prior solar state).\n27\t\n28\t    Raises:\n29\t        ValueError: If ``ds_flare_index_path`` is not provided, or if no overlap exists\n30\t            between the Surya and DS indices within the specified tolerance.\n31\t    \"\"\"\n32\t\n33\t    def __init__(\n34\t        self,\n35\t        # Downstream-specific parameters\n36\t        return_surya_stack: bool = True,\n37\t        max_number_of_samples: int | None = None,\n38\t        ds_flare_index_path: str | None = None,\n39\t        ds_time_column: str | None = None,\n40\t        ds_time_tolerance: str | None = None,\n41\t        ds_match_direction: Literal[\"forward\", \"backward\", \"nearest\"] = \"forward\",\n42\t        # All HelioNetCDFDataset parameters (index_path, scalers, channels, s3_*, etc.)\n43\t        **kwargs,\n44\t    ):\n45\t        if ds_match_direction not in [\"forward\", \"backward\", \"nearest\"]:\n46\t            raise ValueError(\"ds_match_direction must be one of 'forward', 'backward', or 'nearest'\")\n47\t\n48\t        # load_forecast_frames defaults to False here: flare forecasting supplies its\n49\t        # own labels, so future Surya frames never need to be fetched from disk/S3.\n50\t        kwargs.setdefault(\"load_forecast_frames\", False)\n51\t        super().__init__(**kwargs)\n52\t\n53\t        self.return_surya_stack = return_surya_stack\n54\t\n55\t        # Load ds index and find intersection with Surya index\n56\t        if ds_flare_index_path is not None:\n57\t            self.ds_index = pd.read_csv(ds_flare_index_path)\n58\t        else:\n59\t            raise ValueError(\"ds_flare_index_path must be provided for solar_Dataset\")\n60\t\n61\t        self.ds_index[\"ds_index\"] = pd.to_datetime(\n62\t            self.ds_index[ds_time_column]\n63\t        ).values.astype(\"datetime64[ns]\")\n64\t        self.ds_index.sort_values(\"ds_index\", inplace=True)\n65\t",
            "locations": [
