          {
            "title": "python -c \" import torchmetrics as tm print(tm.__version__) import inspect from torchmetrics.functional.classification.stat_scores import _binary_stat_scores_format print(inspect.getsource(_binary_stat_scores_format)) \" 2>&1 | head -60",
            "raw_output": "1.8.2\ndef _binary_stat_scores_format(\n    preds: Tensor,\n    target: Tensor,\n    threshold: float = 0.5,\n    ignore_index: Optional[int] = None,\n) -> tuple[Tensor, Tensor]:\n    \"\"\"Convert all input to label format.\n\n    - If preds tensor is floating point, applies sigmoid if pred tensor not in [0,1] range\n    - If preds tensor is floating point, thresholds afterwards\n    - Mask all datapoints that should be ignored with negative values\n\n    \"\"\"\n    if preds.is_floating_point():\n        preds = normalize_logits_if_needed(preds, \"sigmoid\")\n        preds = preds > threshold\n\n    preds = preds.reshape(preds.shape[0], -1)\n    target = target.reshape(target.shape[0], -1)\n\n    if ignore_index is not None:\n        idx = target == ignore_index\n        target = target.clone()\n        target[idx] = -1\n\n    return preds, target",
