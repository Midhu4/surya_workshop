            "raw_output": "96\t\n97\t    def train_metrics(\n98\t        self, preds: torch.Tensor, target: torch.Tensor\n99\t    ) -> tuple[dict[str, torch.Tensor], list[float]]:\n100\t        \"\"\"\n101\t        Calculate evaluation metrics for training.\n102\t        IMPORTANT:  These metrics are only for reporting purposes and do not\n103\t                    contribute to the training loss. Use only if you want to\n104\t                    monitor additional metrics during training.\n105\t\n106\t        Args:\n107\t            preds (torch.Tensor): Model predictions.\n108\t            target (torch.Tensor): Ground truth labels.\n109\t\n110\t        Returns:\n111\t            tuple[dict[str, torch.Tensor], list[float]]:\n112\t                - dict[str, torch.Tensor]: Dictionary containing the calculated evaluation metrics.\n113\t                                        Keys are metric names, and values are the corresponding torch.Tensor values.\n114\t                - list[float]: List of weights for each calculated metric.\n115\t        \"\"\"\n116\t        output_metrics = {}\n117\t        output_weights = []\n118\t\n119\t        self._ensure_device(preds)\n120\t        output_metrics[\"BinaryAccuracy\"] = self.BinaryAccuracy(preds.reshape(-1).sigmoid(), target.reshape(-1))\n121\t        output_weights.append(1)        \n122\t\n123\t\n124\t        return output_metrics, output_weights\n125\t\n126\t    def val_metrics(\n127\t        self, preds: torch.Tensor, target: torch.Tensor\n128\t    ) -> tuple[dict[str, torch.Tensor], list[float]]:\n129\t        \"\"\"\n130\t        Calculate metrics for validation.\n131\t\n132\t        Args:\n133\t            preds (torch.Tensor): Model predictions.\n134\t            target (torch.Tensor): Ground truth labels.\n135\t\n136\t        Returns:\n137\t            tuple[dict[str, torch.Tensor], list[float]]:\n138\t                - dict[str, torch.Tensor]: Dictionary containing the calculated metrics.\n139\t                                        Keys are metric names (e.g., \"Binary Cross Entropy\"), and values are the\n140\t                                        corresponding torch.Tensor values.\n141\t                - list[float]: List of weights for each calculated metric.\n142\t        \"\"\"\n143\t\n144\t        output_metrics = {}\n145\t        output_weights = []\n146\t\n147\t        output_metrics[\"binary_cross_entropy\"] = torch.nn.functional.binary_cross_entropy_with_logits(preds.reshape(-1), target.reshape(-1))\n148\t        output_weights.append(1)\n149\t\n150\t        self._ensure_device(preds)\n151\t        output_metrics[\"BinaryAccuracy\"] = self.BinaryAccuracy(preds.reshape(-1).sigmoid(), target.reshape(-1))\n152\t        output_weights.append(1)\n153\t\n154\t        return output_metrics, output_weights\n155\t",
