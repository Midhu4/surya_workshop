    {
      "type": "msg",
      "mentions": [],
      "sender": "jupyter-ai-personas::jupyter_ai_acp_client::ClaudeAcpPersona",
      "raw_time": false,
      "id": "df07ad99-6e9b-4c71-a5a4-81edb91a9bec",
      "body": " block ordering, checkpointing, time embedding m",
      "time": 1789584954.44047
    },
    {
      "time": 1789584954.9126656,
      "id": "5db9a093-67ca-4a98-b59b-5957eba4f16f",
      "metadata": {
        "tool_calls": [
          {
            "status": "completed",
            "raw_output": "     1\tfrom __future__ import annotations\n     2\t\n     3\timport dataclasses\n     4\tfrom typing import TYPE_CHECKING\n     5\t\n     6\timport torch\n     7\t\n     8\tif TYPE_CHECKING:\n     9\t    from workshop_infrastructure.configs import ModelConfig\n    10\tfrom torch import nn\n    11\t\n    12\tfrom workshop_infrastructure.models.helio_spectformer import HelioSpectFormer\n    13\tfrom workshop_infrastructure.models.embedding import LinearDecoder, PerceiverDecoder\n    14\t\n    15\t\n    16\t_VALID_POOLINGS = {\"global_average\", \"global_max\", \"attention\", \"transformer\", \"class_token\"}\n    17\t\n    18\t\n    19\tclass ClassToken(nn.Module):\n    20\t    \"\"\"A learnable CLS token, wrapped in a Module so PEFT can keep it trainable.\n    21\t\n    22\t    PEFT's ``modules_to_save`` accepts module *names* only, so a bare\n    23\t    ``nn.Parameter`` on the top-level model would stay frozen in the LoRA\n    24\t    regime.  Wrapping the token in a module lets the ``head_`` convention in\n    25\t    ``apply_peft_lora()`` cover it like any other head component.\n    26\t\n    27\t    Always read the token by **calling** the module (``self.head_cls_token(B)``).\n    28\t    Under PEFT the module is replaced by a wrapper that dispatches ``forward``\n    29\t    to the trainable copy; reaching for the ``.token`` attribute instead\n    30\t    delegates in version-dependent ways and can silently hand back the frozen\n    31\t    original.\n    32\t    \"\"\"\n    33\t\n    34\t    def __init__(self, embed_dim: int, init: str = \"zeros\"):\n    35\t        super().__init__()\n    36\t        if init == \"zeros\":\n    37\t            data = torch.zeros(1, 1, embed_dim)\n    38\t        elif init == \"randn\":\n    39\t            data = torch.randn(1, 1, embed_dim)\n    40\t        else:\n    41\t            raise ValueError(f\"init must be 'zeros' or 'randn', got {init!r}\")\n    42\t        self.token = nn.Parameter(data)\n    43\t\n    44\t    def forward(self, batch_size: int = 1) -> torch.Tensor:\n    45\t        \"\"\"Return the token expanded to ``batch_size``, shape (batch_size, 1, embed_dim).\n    46\t\n    47\t        The argument is required: PEFT's wrapper forwards at least one\n    48\t        positional argument, so a zero-argument ``forward()`` would raise.\n    49\t        \"\"\"\n    50\t        return self.token.expand(batch_size, -1, -1)\n    51\t\n    52\t\n    53\tclass HelioSpectformer1D(nn.Module):\n    54\t    \"\"\"\n    55\t    Fine-tuning wrapper for 1D outputs (e.g. regression or classification).\n    56\t\n    57\t    Holds a frozen-or-trainable HelioSpectFormer backbone and adds a pooling\n    58\t    layer plus a linear head on top. Only the head-specific parameters are\n    59\t    defined here; all backbone parameters are forwarded to HelioSpectFormer.\n    60\t\n    61\t    Every trainable head component is a direct child whose name starts with\n    62\t    ``head_``.  ``apply_peft_lora()`` discovers them by that prefix and keeps\n    63\t    them trainable via ``modules_to_save``; see its docstring before adding a\n    64\t    new head layer.\n    65\t    \"\"\"\n    66\t\n    67\t    def __init__(\n    68\t        self,\n    69\t        # --- Backbone ---\n    70\t        img_size: int,\n    71\t        patch_size: int,\n    72\t        in_chans: int,\n    73\t        embed_dim: int,\n    74\t        time_embedding: dict,\n    75\t        depth: int,\n    76\t        n_spectral_blocks: int,\n    77\t        num_heads: int,\n    78\t        mlp_ratio: float,\n    79\t        drop_rate: float,\n    80\t        window_size: int,\n    81\t        dp_rank: int,\n    82\t        learned_flow: bool = False,\n    83\t        use_latitude_in_learned_flow: bool = False,\n    84\t        init_weights: bool = False,\n    85\t        checkpoint_layers: list[int] | None = None,\n    86\t        rpe: bool = False,\n    87\t        ensemble: int | None = None,\n    88\t        dtype: torch.dtype = torch.bfloat16,\n    89\t        # --- Fine-tuning head ---\n    90\t        dropout: float = 0.1,\n    91\t        num_outputs: int = 1,\n    92\t        num_penultimate_transformer_layers: int = 1,\n    93\t        num_penultimate_heads: int = 8,\n    94\t        pooling: str = \"class_token\",\n    95\t        penultimate_linear_layer: bool = True,\n    96\t    ):\n    97\t        super().__init__()\n    98\t\n    99\t        if pooling not in _VALID_POOLINGS:\n   100\t            raise ValueError(f\"pooling must be one of {_VALID_POOLINGS}, got {pooling!r}\")\n   101\t\n   102\t        # Only \"class_token\" pooling prepends a global token to the backbone input (via\n   103\t        # forward_with_cls_token, below); every other pooling must run with nglo=0 or the\n   104\t        # long-short attention reshape fails. \"transformer\" pooling also uses a class token,\n   105\t        # but concatenates it after the backbone, so it is not \"class_token\" here.\n   106\t        nglo = 1 if pooling == \"class_token\" else 0\n   107\t\n   108\t        self.backbone = HelioSpectFormer(\n   109\t            img_size=img_size,\n   110\t            patch_size=patch_size,\n   111\t            in_chans=in_chans,\n   112\t            embed_dim=embed_dim,\n   113\t            time_embedding=time_embedding,\n   114\t            depth=depth,\n   115\t            n_spectral_blocks=n_spectral_blocks,\n   116\t            num_heads=num_heads,\n   117\t            mlp_ratio=mlp_ratio,\n   118\t            drop_rate=drop_rate,\n   119\t            window_size=window_size,\n   120\t            dp_rank=dp_rank,\n   121\t            learned_flow=learned_flow,\n   122\t            use_latitude_in_learned_flow=use_latitude_in_learned_flow,\n   123\t            init_weights=init_weights,\n   124\t            checkpoint_layers=checkpoint_layers,\n   125\t            rpe=rpe,\n   126\t            ensemble=ensemble,\n   127\t            finetune=True,  # always strip the pretraining decoder\n   128\t            dtype=dtype,\n   129\t            nglo=nglo,\n   130\t        )\n   131\t\n   132\t        self.pooling = pooling\n   133\t        self.embed_dim = embed_dim\n   134\t        self.head_dropout = nn.Dropout(dropout) if dropout > 0 else None\n   135\t        self.penultimate_linear_layer_enabled = penultimate_linear_layer\n   136\t\n   137\t        if pooling == \"attention\":\n   138\t            self.head_attn_pool = nn.MultiheadAttention(\n   139\t                embed_dim, num_penultimate_heads, dropout=dropout\n   140\t            )\n   141\t\n   142\t        elif pooling == \"transformer\":\n   143\t            self.head_cls_token = ClassToken(embed_dim, init=\"randn\")\n   144\t            encoder_layer = nn.TransformerEncoderLayer(\n   145\t                d_model=embed_dim,\n   146\t                nhead=num_penultimate_heads,\n   147\t                dim_feedforward=embed_dim,\n   148\t                dropout=dropout,\n   149\t            )\n   150\t            self.head_transformer = nn.TransformerEncoder(\n   151\t                encoder_layer, num_layers=num_penultimate_transformer_layers\n   152\t            )\n   153\t\n   154\t        elif pooling == \"class_token\":\n   155\t            self.head_cls_token = ClassToken(embed_dim, init=\"zeros\")\n   156\t\n   157\t        if penultimate_linear_layer:\n   158\t            self.head_linear = nn.Linear(embed_dim, embed_dim)\n   159\t\n   160\t        self.head_unembed = nn.Linear(embed_dim, num_outputs)\n   161\t\n   162\t    def forward(self, batch):\n   163\t        if self.pooling == \"class_token\":\n   164\t            # (1, 1, D) -- forward_with_cls_token expands it over the batch itself.\n   165\t            tokens = self.backbone.forward_with_cls_token(batch, self.head_cls_token(1))\n   166\t        else:\n   167\t            tokens = self.backbone.forward(batch)\n   168\t\n   169\t        if self.penultimate_linear_layer_enabled:\n   170\t            tokens = self.head_linear(tokens)\n   171\t\n   172\t        if self.pooling == \"global_average\":\n   173\t            agg_tokens = torch.mean(tokens, dim=1)\n   174\t        elif self.pooling == \"global_max\":\n   175\t            agg_tokens, _ = torch.max(tokens, dim=1)\n   176\t        elif self.pooling == \"attention\":\n   177\t            tokens = tokens.permute(1, 0, 2)\n   178\t            # Positional, not keyword: under PEFT this module is replaced by a\n   179\t            # wrapper whose forward requires at least one positional argument.\n   180\t            tokens, _ = self.head_attn_pool(tokens, tokens, tokens)\n   181\t            agg_tokens = tokens.sum(dim=0)\n   182\t        elif self.pooling == \"transformer\":\n   183\t            B = tokens.size(0)\n   184\t            tokens = torch.cat((self.head_cls_token(B), tokens), dim=1)\n   185\t            tokens = self.head_transformer(tokens.permute(1, 0, 2))\n   186\t            agg_tokens = tokens[0, :, :]\n   187\t        elif self.pooling == \"class_token\":\n   188\t            agg_tokens = tokens.squeeze(dim=1)\n   189\t\n   190\t        if self.head_dropout is not None:\n   191\t            agg_tokens = self.head_dropout(agg_tokens)\n   192\t\n   193\t        return self.head_unembed(agg_tokens).squeeze(dim=1)\n   194\t\n   195\t    @classmethod\n   196\t    def from_config(cls, cfg: \"ModelConfig\", **overrides) -> \"HelioSpectformer1D\":\n   197\t        \"\"\"Construct from a ModelConfig, with optional field overrides.\n   198\t\n   199\t        Fields that live outside ModelConfig (e.g. ``dtype``,\n   200\t        ``use_latitude_in_learned_flow``) should be supplied via ``overrides``.\n   201\t        \"\"\"\n   202\t        kwargs = dict(\n   203\t            img_size=cfg.img_size,\n   204\t            patch_size=cfg.patch_size,\n   205\t            in_chans=cfg.in_channels,\n   206\t            embed_dim=cfg.embed_dim,\n   207\t            time_embedding=dataclasses.asdict(cfg.time_embedding),\n   208\t            depth=cfg.depth,\n   209\t            n_spectral_blocks=cfg.spectral_blocks,\n   210\t            num_heads=cfg.num_heads,\n   211\t            mlp_ratio=cfg.mlp_ratio,\n   212\t            drop_rate=cfg.drop_rate,\n   213\t            window_size=cfg.window_size,\n   214\t            dp_rank=cfg.dp_rank,\n   215\t            learned_flow=cfg.learned_flow,\n   216\t            init_weights=cfg.init_weights,\n   217\t            checkpoint_layers=cfg.checkpoint_layers,\n   218\t            rpe=cfg.rpe,\n   219\t            ensemble=cfg.ensemble,\n   220\t            dropout=cfg.dropout,\n   221\t            pooling=cfg.pooling,\n   222\t            penultimate_linear_layer=cfg.penultimate_linear_layer,\n   223\t        )\n   224\t        kwargs.update(overrides)\n   225\t        return cls(**kwargs)\n   226\t\n   227\t\n   228\tclass HelioSpectformer2D(nn.Module):\n   229\t    \"\"\"\n   230\t    Fine-tuning wrapper for 2D outputs (e.g. image reconstruction or forecasting).\n   231\t\n   232\t    Holds a HelioSpectFormer backbone and adds a spatial decoder head on top.\n   233\t\n   234\t    As with HelioSpectformer1D, every trainable head component is a direct\n   235\t    child whose name starts with ``head_`` -- see ``apply_peft_lora()``.\n   236\t    \"\"\"\n   237\t\n   238\t    def __init__(\n   239\t        self,\n   240\t        # --- Backbone ---\n   241\t        img_size: int,\n   242\t        patch_size: int,\n   243\t        in_chans: int,\n   244\t        embed_dim: int,\n   245\t        time_embedding: dict,\n   246\t        depth: int,\n   247\t        n_spectral_blocks: int,\n   248\t        num_heads: int,\n   249\t        mlp_ratio: float,\n   250\t        drop_rate: float,\n   251\t        window_size: int,\n   252\t        dp_rank: int,\n   253\t        learned_flow: bool = False,\n   254\t        use_latitude_in_learned_flow: bool = False,\n   255\t        init_weights: bool = False,\n   256\t        dtype: torch.dtype = torch.bfloat16,\n   257\t        checkpoint_layers: list[int] | None = None,\n   258\t        rpe: bool = False,\n   259\t        # --- Fine-tuning head ---\n   260\t        ft_unembedding_type: str = \"linear\",\n   261\t        ft_out_chans: int = 1,\n   262\t    ):\n   263\t        super().__init__()\n   264\t\n   265\t        self.backbone = HelioSpectFormer(\n   266\t            img_size=img_size,\n   267\t            patch_size=patch_size,\n   268\t            in_chans=in_chans,\n   269\t            embed_dim=embed_dim,\n   270\t            time_embedding=time_embedding,\n   271\t            depth=depth,\n   272\t            n_spectral_blocks=n_spectral_blocks,\n   273\t            num_heads=num_heads,\n   274\t            mlp_ratio=mlp_ratio,\n   275\t            drop_rate=drop_rate,\n   276\t            window_size=window_size,\n   277\t            dp_rank=dp_rank,\n   278\t            learned_flow=learned_flow,\n   279\t            use_latitude_in_learned_flow=use_latitude_in_learned_flow,\n   280\t            init_weights=init_weights,\n   281\t            dtype=dtype,\n   282\t            checkpoint_layers=checkpoint_layers,\n   283\t            rpe=rpe,\n   284\t            finetune=True,  # always strip the pretraining decoder\n   285\t        )\n   286\t\n   287\t        if ft_unembedding_type == \"linear\":\n   288\t            self.head_unembed = LinearDecoder(\n   289\t                patch_size=patch_size,\n   290\t                out_chans=ft_out_chans,\n   291\t                embed_dim=embed_dim,\n   292\t            )\n   293\t        elif ft_unembedding_type == \"perceiver\":\n   294\t            self.head_unembed = PerceiverDecoder(\n   295\t                embed_dim=embed_dim,\n   296\t                patch_size=patch_size,\n   297\t                out_chans=ft_out_chans,\n   298\t            )\n   299\t        else:\n   300\t            raise ValueError(\n   301\t                f\"ft_unembedding_type must be 'linear' or 'perceiver', got {ft_unembedding_type!r}\"\n   302\t            )\n   303\t\n   304\t    def forward(self, batch):\n   305\t        tokens = self.backbone.forward(batch)\n   306\t        return self.head_unembed(tokens)  # (B, L, D) -> (B, C, H, W)\n   307\t\n   308\t    @classmethod\n   309\t    def from_config(cls, cfg: \"ModelConfig\", **overrides) -> \"HelioSpectformer2D\":\n   310\t        \"\"\"Construct from a ModelConfig, with optional field overrides.\n   311\t\n   312\t        Fields that live outside ModelConfig (e.g. ``dtype``,\n   313\t        ``use_latitude_in_learned_flow``, ``ft_unembedding_type``,\n   314\t        ``ft_out_chans``) should be supplied via ``overrides``.\n   315\t        \"\"\"\n   316\t        kwargs = dict(\n   317\t            img_size=cfg.img_size,\n   318\t            patch_size=cfg.patch_size,\n   319\t            in_chans=cfg.in_channels,\n   320\t            embed_dim=cfg.embed_dim,\n   321\t            time_embedding=dataclasses.asdict(cfg.time_embedding),\n   322\t            depth=cfg.depth,\n   323\t            n_spectral_blocks=cfg.spectral_blocks,\n   324\t            num_heads=cfg.num_heads,\n   325\t            mlp_ratio=cfg.mlp_ratio,\n   326\t            drop_rate=cfg.drop_rate,\n   327\t            window_size=cfg.window_size,\n   328\t            dp_rank=cfg.dp_rank,\n   329\t            learned_flow=cfg.learned_flow,\n   330\t            init_weights=cfg.init_weights,\n   331\t            checkpoint_layers=cfg.checkpoint_layers,\n   332\t            rpe=cfg.rpe,\n   333\t        )\n   334\t        kwargs.update(overrides)\n   335\t        return cls(**kwargs)",
