            "tool_call_id": "toolu_bdrk_01G6YNqhhnA5TKdUXYXYcx8z",
            "raw_output": "     1\timport torch\n     2\tfrom einops import rearrange\n     3\tfrom itertools import chain\n     4\tfrom torch import nn\n     5\tfrom torch.utils.checkpoint import checkpoint\n     6\t\n     7\timport numpy as np\n     8\t\n     9\tfrom .spectformer import SpectFormer, BlockSpectralGating, BlockAttention\n    10\tfrom .embedding import (\n    11\t    LinearEmbedding,\n    12\t    PatchEmbed3D,\n    13\t    PerceiverChannelEmbedding,\n    14\t    LinearDecoder,\n    15\t    PerceiverDecoder,\n    16\t)\n    17\tfrom .flow import HelioFlowModel\n    18\t\n    19\t\n    20\tclass HelioSpectFormer(nn.Module):\n    21\t    \"\"\"\n    22\t    A note on the ensemble capability:\n    23\t        Ensembles of size E are generated by setting `ensemble=E`. In this case, the forward\n    24\t        pass generates ensemble members after tokenization by increasing the batch dimension\n    25\t        B to B x E. Noise is injected in the `self.backbone` Specformer blocks. After the\n    26\t        backbone, ensemble members ride along implicitly in the batch dimension. (This is\n    27\t        mainly through the `self.unembed` pass.) An explicit ensemble dimension is only\n    28\t        generated at the end.\n    29\t    \"\"\"\n    30\t\n    31\t    def __init__(\n    32\t        self,\n    33\t        img_size: int,\n    34\t        patch_size: int,\n    35\t        in_chans: int,\n    36\t        embed_dim: int,\n    37\t        time_embedding: dict,\n    38\t        depth: int,\n    39\t        n_spectral_blocks: int,\n    40\t        num_heads: int,\n    41\t        mlp_ratio: float,\n    42\t        drop_rate: float,\n    43\t        window_size: int,\n    44\t        dp_rank: int,\n    45\t        learned_flow: bool = False,\n    46\t        use_latitude_in_learned_flow: bool = False,\n    47\t        init_weights: bool = False,\n    48\t        checkpoint_layers: list[int] | None = None,\n    49\t        rpe: bool = False,\n    50\t        ensemble: int | None = None,\n    51\t        finetune: bool = True,\n    52\t        nglo: int = 0,\n    53\t        dtype: torch.dtype | None = None,\n    54\t    ) -> None:\n    55\t        \"\"\"\n    56\t        Args:\n    57\t            img_size: input image size\n    58\t            patch_size: patch size\n    59\t            in_chans: number of iput channels\n    60\t            embed_dim: embeddin dimension\n    61\t            time_embedding: dictionary to configure temporal embedding:\n    62\t                `type` (str, required): indicates embedding type. `linear`, `perceiver`.\n    63\t                `time_dim` (int): indicates length of time dimension. required for linear embedding.\n    64\t                `n_queries` (int): indicates number of perceiver queries. required for perceiver.\n    65\t            depth: number of transformer blocks\n    66\t            n_spectral_blocks: number of spectral gating blocks\n    67\t            num_heads: Number of transformer heads\n    68\t            mlp_ratio: MLP ratio for transformer blocks\n    69\t            drop_rate: dropout rate\n    70\t            window_size: window size for long/short attention\n    71\t            dp_rank: dp rank for long/short attention\n    72\t            learned_flow: if true, combine learned flow model with spectformer\n    73\t            use_latitude_in_learned_flow: use latitudes in learned flow\n    74\t            init_weights: use optimized weight initialization\n    75\t            checkpoint_layers: indicate which layers to use for checkpointing\n    76\t            rpe: Use relative position encoding in Long-Short attention blocks.\n    77\t            ensemble: Integer indicating ensemble size or None for deterministic model.\n    78\t            finetune: Indicates whether to train from scrach or fine-tune the model. If set to `True`, the final output layers are removed.\n    79\t            nglo: Number of (additional) global tokens.\n    80\t            dtype: A torch data type. Not used and added only for compatibility with the remainder of the codebase.\n    81\t        \"\"\"\n    82\t        super().__init__()\n    83\t\n    84\t        self.learned_flow = learned_flow\n    85\t        self.patch_size = patch_size\n    86\t        self.embed_dim = embed_dim\n    87\t        self.in_chans = in_chans\n    88\t        self.time_embedding = time_embedding\n    89\t        self.ensemble = ensemble\n    90\t        self.finetune = finetune\n    91\t        self.nglo = nglo\n    92\t\n    93\t        if learned_flow:\n    94\t            self.learned_flow_model = HelioFlowModel(\n    95\t                img_size=(img_size, img_size),\n    96\t                use_latitude_in_learned_flow=use_latitude_in_learned_flow,\n    97\t            )\n    98\t\n    99\t        match time_embedding[\"type\"]:\n   100\t            case \"linear\":\n   101\t                self.time_dim = time_embedding[\"time_dim\"]\n   102\t                if learned_flow:\n   103\t                    self.time_dim += 1\n   104\t                self.embedding = LinearEmbedding(\n   105\t                    img_size, patch_size, in_chans, self.time_dim, embed_dim, drop_rate\n   106\t                )\n   107\t\n   108\t                if not self.finetune:\n   109\t                    self.unembed = LinearDecoder(\n   110\t                        patch_size=patch_size, out_chans=in_chans, embed_dim=embed_dim\n   111\t                    )\n   112\t            case \"perceiver\":\n   113\t                self.embedding = PerceiverChannelEmbedding(\n   114\t                    in_chans=in_chans,\n   115\t                    img_size=img_size,\n   116\t                    patch_size=patch_size,\n   117\t                    time_dim=time_embedding[\"time_dim\"],\n   118\t                    num_queries=time_embedding[\"n_queries\"],\n   119\t                    embed_dim=embed_dim,\n   120\t                    drop_rate=drop_rate,\n   121\t                )\n   122\t                if not self.finetune:\n   123\t                    self.unembed = PerceiverDecoder(\n   124\t                        embed_dim=embed_dim,\n   125\t                        patch_size=patch_size,\n   126\t                        out_chans=in_chans,\n   127\t                    )\n   128\t            case _:\n   129\t                raise NotImplementedError(\n   130\t                    f'Embedding {time_embedding[\"type\"]} has not been implemented.'\n   131\t                )\n   132\t\n   133\t        if isinstance(depth, list):\n   134\t            raise NotImplementedError(\n   135\t                \"Multi scale models are no longer supported. Depth should be a single integer.\"\n   136\t            )\n   137\t        self.backbone = SpectFormer(\n   138\t            grid_size=img_size // patch_size,\n   139\t            embed_dim=embed_dim,\n   140\t            depth=depth,\n   141\t            n_spectral_blocks=n_spectral_blocks,\n   142\t            num_heads=num_heads,\n   143\t            mlp_ratio=mlp_ratio,\n   144\t            drop_rate=drop_rate,\n   145\t            window_size=window_size,\n   146\t            dp_rank=dp_rank,\n   147\t            checkpoint_layers=checkpoint_layers,\n   148\t            rpe=rpe,\n   149\t            ensemble=ensemble,\n   150\t            nglo=nglo,\n   151\t        )\n   152\t\n   153\t        if init_weights:\n   154\t            self.apply(self._init_weights)\n   155\t\n   156\t    # @staticmethod\n   157\t    # def _checkpoint_wrapper(\n   158\t    #    model: nn.Module, data: tuple[Tensor, Tensor | None]\n   159\t    # ) -> Tensor:\n   160\t    #    return checkpoint(model, data, use_reentrant=False)\n   161\t\n   162\t    def _init_weights(self, module):\n   163\t\n   164\t        if self.time_embedding[\"type\"] == \"linear\":\n   165\t            # sampling_step * embed_dim = patch_size**2 * in_chans * time_dim\n   166\t            sampling_step = int(\n   167\t                np.sqrt(\n   168\t                    (self.patch_size**2 * self.in_chans * self.time_dim)\n   169\t                    / self.embed_dim\n   170\t                )\n   171\t            )\n   172\t        else:\n   173\t            sampling_step = int(\n   174\t                np.sqrt((self.patch_size**2 * self.in_chans) / self.embed_dim)\n   175\t            )\n   176\t        if isinstance(module, PatchEmbed3D):\n   177\t            torch.nn.init.zeros_(module.proj.weight)\n   178\t            c_out = 0\n   179\t            w_pool = 1.0 / sampling_step\n   180\t            for k in range(self.in_chans * self.time_dim):\n   181\t                for i in range(0, self.patch_size, sampling_step):\n   182\t                    for j in range(0, self.patch_size, sampling_step):\n   183\t                        module.proj.weight.data[\n   184\t                            c_out, k, i : i + sampling_step, j : j + sampling_step\n   185\t                        ] = w_pool\n   186\t                        c_out += 1\n   187\t            if module.proj.bias is not None:\n   188\t                module.proj.bias.data.zero_()\n   189\t        if isinstance(module, BlockSpectralGating):\n   190\t            for m in [\n   191\t                module.mlp.fc1,\n   192\t                module.mlp.fc2,\n   193\t            ]:\n   194\t                # m.weight.data.normal_(mean=0.0, std=0.01)\n   195\t                # torch.nn.init.eye_(m.weight)\n   196\t                torch.nn.init.eye_(m.weight)\n   197\t                if m.bias is not None:\n   198\t                    m.bias.data.zero_()\n   199\t        if isinstance(module, BlockAttention):\n   200\t            for m in [\n   201\t                module.mlp.fc1,\n   202\t                module.mlp.fc2,\n   203\t            ]:\n   204\t                # torch.nn.init.eye_(m.weight)\n   205\t                torch.nn.init.zeros_(m.weight)\n   206\t                if m.bias is not None:\n   207\t                    m.bias.data.zero_()\n   208\t            for m in [\n   209\t                module.attn.qkv,\n   210\t                module.attn.proj,\n   211\t                module.attn.to_dynamic_projection,\n   212\t            ]:\n   213\t                # m.weight.data.normal_(mean=0.0, std=0.01)\n   214\t                # torch.nn.init.eye_(m.weight)\n   215\t                torch.nn.init.zeros_(m.weight)\n   216\t                if m.bias is not None:\n   217\t                    m.bias.data.zero_()\n   218\t        if isinstance(module, torch.nn.Sequential):\n   219\t            if isinstance(module[1], torch.nn.PixelShuffle):\n   220\t                # torch.nn.init.eye_(module[0].weight.data[:,:,0,0])\n   221\t                torch.nn.init.zeros_(module[0].weight)\n   222\t                if self.time_embedding[\"type\"] == \"linear\":\n   223\t                    c_out = 0\n   224\t                    for k in range(1, self.in_chans + 1):\n   225\t                        for i in range(\n   226\t                            self.patch_size**2 // (self.patch_size * sampling_step)\n   227\t                        ):\n   228\t                            for j in range(self.patch_size):\n   229\t                                module[0].weight.data[\n   230\t                                    c_out : c_out + sampling_step,\n   231\t                                    j + (k * self.time_dim - 1) * self.patch_size,\n   232\t                                ] = 1.0\n   233\t                                c_out += sampling_step\n   234\t                else:\n   235\t                    c_out = 0\n   236\t                    for k in range(2 * self.in_chans):\n   237\t                        # l = 0\n   238\t                        for l_feat in range(self.backbone.embed_dim):\n   239\t                            module[0].weight.data[c_out, l_feat] = 1.0\n   240\t                            c_out += 1\n   241\t                if module[0].bias is not None:\n   242\t                    module[0].bias.data.zero_()\n   243\t\n   244\t    def forward_with_cls_token(self, batch, cls_token: torch.nn.Parameter) -> torch.Tensor:\n   245\t        \"\"\"Run the backbone with a CLS token injected between spectral and attention blocks.\n   246\t\n   247\t        The CLS token is inserted at the boundary between spectral gating blocks and\n   248\t        attention blocks so that it attends over all patch tokens. Only the CLS token\n   249\t        output is returned.\n   250\t\n   251\t        Args:\n   252\t            batch: Dictionary with keys ``ts`` (B, C, T, H, W) and ``time_delta_input`` (B, T).\n   253\t            cls_token: Learnable CLS token parameter of shape (1, 1, embed_dim).\n   254\t\n   255\t        Returns:\n   256\t            Tensor of shape (B, 1, embed_dim) \u2014 the CLS token after the full forward pass.\n   257\t        \"\"\"\n   258\t        x = batch[\"ts\"]\n   259\t        dt = batch[\"time_delta_input\"]\n   260\t        B = x.shape[0]\n   261\t\n   262\t        if self.learned_flow:\n   263\t            y_hat_flow = self.learned_flow_model(batch)\n   264\t            if any(param.requires_grad for param in self.learned_flow_model.parameters()):\n   265\t                return y_hat_flow\n   266\t            else:\n   267\t                x = torch.concat((x, y_hat_flow.unsqueeze(2)), dim=2)\n   268\t                if self.time_embedding[\"type\"] == \"perceiver\":\n   269\t                    dt = torch.cat((dt, batch[\"lead_time_delta\"].reshape(-1, 1)), dim=1)\n   270\t\n   271\t        tokens = self.embedding(x, dt)\n   272\t\n   273\t        if self.ensemble:\n   274\t            raise NotImplementedError(\n   275\t                \"CLS token pooling has not been implemented with ensemble modifications.\"\n   276\t            )\n   277\t\n   278\t        noise = None\n   279\t        for i, blk in enumerate(\n   280\t            chain(self.backbone.blocks_spectral_gating, self.backbone.blocks_attention)\n   281\t        ):\n   282\t            if i == self.backbone.n_spectral_blocks:\n   283\t                tokens = torch.cat(\n   284\t                    (cls_token.expand(B, 1, self.embed_dim), tokens),\n   285\t                    dim=1,\n   286\t                )\n   287\t            tokens = (\n   288\t                checkpoint(blk, tokens, noise, use_reentrant=False)\n   289\t                if i in self.backbone._checkpoint_layers\n   290\t                else blk(tokens, noise)\n   291\t            )\n   292\t\n   293\t        return tokens[:, [0], :]\n   294\t\n   295\t    def forward(self, batch):\n   296\t        \"\"\"\n   297\t        Args:\n   298\t            batch: Dictionary containing keys `ts` and `time_delta_input`.\n   299\t            Their values are tensors with shapes as follows.\n   300\t                ts:                B, C, T, H, W\n   301\t                time_delta_input:  B, T\n   302\t        Returns:\n   303\t            Tensor fo shape (B, C, H, W) for deterministic or (B, E, C, H, W) for ensemble forecasts.\n   304\t        \"\"\"\n   305\t        x = batch[\"ts\"]\n   306\t        dt = batch[\"time_delta_input\"]\n   307\t        B, C, T, H, W = x.shape\n   308\t\n   309\t        if self.learned_flow:\n   310\t            y_hat_flow = self.learned_flow_model(batch)  # B, C, H, W\n   311\t            if any(\n   312\t                [param.requires_grad for param in self.learned_flow_model.parameters()]\n   313\t            ):\n   314\t                return y_hat_flow\n   315\t            else:\n   316\t                x = torch.concat((x, y_hat_flow.unsqueeze(2)), dim=2)  # B, C, T+1, H, W\n   317\t                if self.time_embedding[\"type\"] == \"perceiver\":\n   318\t                    dt = torch.cat((dt, batch[\"lead_time_delta\"].reshape(-1, 1)), dim=1)\n   319\t\n   320\t        # embed the data\n   321\t        tokens = self.embedding(x, dt)\n   322\t\n   323\t        # copy tokens in case of ensemble forecast\n   324\t        if self.ensemble:\n   325\t            # B L D -> (B E) L D == BE L D\n   326\t            tokens = torch.repeat_interleave(tokens, repeats=self.ensemble, dim=0)\n   327\t\n   328\t        # pass the time series through the encoder\n   329\t        tokens = self.backbone(tokens)\n   330\t\n   331\t        if self.finetune:\n   332\t            return tokens\n   333\t\n   334\t        # Unembed the tokens\n   335\t        # BE L D -> BE C H W\n   336\t        forecast_hat = self.unembed(tokens)\n   337\t\n   338\t        assert forecast_hat.shape == (\n   339\t            B * self.ensemble if self.ensemble else B,\n   340\t            C,\n   341\t            H,\n   342\t            W,\n   343\t        ), f\"forecast_hat has shape {forecast_hat.shape} yet expected {(B*self.ensemble if self.ensemble else B, C, H, W)}.\"\n   344\t\n   345\t        if self.learned_flow:\n   346\t            assert y_hat_flow.shape == (\n   347\t                B,\n   348\t                C,\n   349\t                H,\n   350\t                W,\n   351\t            ), f\"y_hat_flow has shape {y_hat_flow.shape} yet expected {(B, C, H, W)}.\"\n   352\t            if self.ensemble:\n   353\t                y_hat_flow = torch.repeat_interleave(\n   354\t                    y_hat_flow, repeats=self.ensemble, dim=0\n   355\t                )\n   356\t            assert y_hat_flow.shape == forecast_hat.shape\n   357\t            forecast_hat = forecast_hat + y_hat_flow\n   358\t\n   359\t        assert forecast_hat.shape == (\n   360\t            B * self.ensemble if self.ensemble else B,\n   361\t            C,\n   362\t            H,\n   363\t            W,\n   364\t        ), f\"forecast_hat has shape {forecast_hat.shape} yet expected {(B*self.ensemble if self.ensemble else B, C, H, W)}.\"\n   365\t\n   366\t        if self.ensemble:\n   367\t            forecast_hat = rearrange(\n   368\t                forecast_hat, \"(B E) C H W -> B E C H W\", B=B, E=self.ensemble\n   369\t            )\n   370\t\n   371\t        return forecast_hat",
            "title": "cat -n helio_spectformer.py",
