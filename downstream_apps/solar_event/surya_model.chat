            "selected_option_id": "allow-once",
            "tool_call_id": "toolu_bdrk_018tgFDQxhTUa8cD6s6Q67dz",
            "raw_output": "     1\t\"\"\"\n     2\tTyped configuration for Surya downstream applications.\n     3\t\n     4\tEverything a fine-tuning run needs is declared here:\n     5\t\n     6\t- ``TimeEmbeddingConfig`` / ``LoraAdapterConfig`` / ``ModelConfig`` \u2014 the backbone\n     7\t  architecture and fine-tuning head, mirroring the HelioSpectformer constructors.\n     8\t- ``DataConfig`` / ``OutputConfig`` / ``TrainingConfig`` \u2014 the parts of a run that every\n     9\t  downstream task has: what data to load, where checkpoints go, and the optimizer /\n    10\t  logging settings.\n    11\t- ``load_config()`` \u2014 the single entry point. Reads the YAML and returns a fully typed\n    12\t  ``TrainingConfig``, so downstream code never passes raw dicts around.\n    13\t\n    14\t**Adding task-specific settings:** subclass ``DataConfig`` in your app and pass the\n    15\tsubclass to ``load_config(path, data_cls=YourDataConfig)``. You do not copy this file.\n    16\tSee ``downstream_apps/template/configs.py`` for a worked example.\n    17\t\"\"\"\n    18\t\n    19\tfrom __future__ import annotations\n    20\t\n    21\timport os\n    22\tfrom dataclasses import MISSING, dataclass, field, fields as dc_fields\n    23\tfrom pathlib import Path\n    24\tfrom typing import ClassVar, List, Optional, Union\n    25\t\n    26\timport yaml\n    27\t\n    28\t# Environment variable consulted when data.s3_cache_dir is left unset in the config.\n    29\t# It lets one committed config run on machines with different scratch space, without an\n    30\t# absolute path pointing into one user's home ending up in version control.\n    31\tS3_CACHE_DIR_ENV_VAR = \"SURYA_WS_CACHE_DIR\"\n    32\t\n    33\t\n    34\t# How HelioNetCDFDataset reads s3:// paths. Declared here rather than in helio.py so the\n    35\t# config layer can reject a bad value at startup, before any dataset is constructed.\n    36\t#   \"download\"    \u2014 fetch the whole object into s3_cache_dir, then open it locally.\n    37\t#                   Recommended: NetCDF/HDF5 needs random seeks that streaming cannot serve.\n    38\t#   \"simplecache\" \u2014 fsspec read-through cache into s3_cache_dir.\n    39\t#   \"stream\"      \u2014 direct s3fs handle, no local cache. Works, but roughly 9x slower on\n    40\t#                   full SDO frames: HDF5 random access becomes many small ranged GETs.\n    41\tVALID_S3_MODES = (\"download\", \"simplecache\", \"stream\")\n    42\t\n    43\t# Accepted values for training.deterministic, passed straight to lightning.Trainer.\n    44\t#   False   \u2014 no determinism guarantees; two identical runs may differ. The default,\n    45\t#             chosen for throughput: determinism costs roughly 20% of wall time.\n    46\t#   \"warn\"  \u2014 bit-identical wherever a deterministic kernel exists; warn (naming the op)\n    47\t#             where one does not. Never blocks a run. Switch to this whenever you need to\n    48\t#             attribute a change in results to your edit rather than to run-to-run drift.\n    49\t#   True    \u2014 hard guarantee; any op without a deterministic kernel raises. Note that\n    50\t#             model.learned_flow uses F.grid_sample, which has no deterministic CUDA\n    51\t#             backward, so learned_flow: true is incompatible with this setting.\n    52\tVALID_DETERMINISTIC = (True, False, \"warn\")\n    53\t\n    54\t\n    55\t@dataclass\n    56\tclass TimeEmbeddingConfig:\n    57\t    \"\"\"Controls how temporal position is encoded before the transformer blocks.\"\"\"\n    58\t    type: str = \"linear\"         # \"linear\" | \"fourier\" | \"perceiver\"\n    59\t    n_queries: Optional[int] = None  # Required for \"perceiver\"; unused otherwise\n    60\t    time_dim: int = 1            # Number of input timesteps\n    61\t\n    62\t\n    63\t@dataclass\n    64\tclass LoraAdapterConfig:\n    65\t    \"\"\"\n    66\t    Settings for PEFT LoRA fine-tuning.\n    67\t\n    68\t    Passed to apply_peft_lora(); mirrors the fields of peft.LoraConfig.\n    69\t    Named LoraAdapterConfig to avoid confusion with peft.LoraConfig.\n    70\t\n    71\t    The default target_modules match the Surya backbone's actual layer names:\n    72\t    the feed-forward layers (fc1/fc2) in all blocks, plus the fused attention\n    73\t    projection (attn.qkv) and output projection (attn.proj) in the attention\n    74\t    blocks.  The dotted forms are deliberate -- a bare \"proj\" would also match\n    75\t    the Conv2d patch-embedding tokeniser at embedding.patch_embed.proj.\n    76\t\n    77\t    PEFT only errors when *no* entry matches anything, so a misspelt name is\n    78\t    silently ignored; keep this list in sync with the backbone.\n    79\t\n    80\t    There is no modules_to_save field: apply_peft_lora() discovers the\n    81\t    fine-tuning head automatically from the ``head_`` naming convention.\n    82\t    \"\"\"\n    83\t    r: int = 8\n    84\t    lora_alpha: int = 8\n    85\t    target_modules: List[str] = field(\n    86\t        default_factory=lambda: [\"fc1\", \"fc2\", \"attn.qkv\", \"attn.proj\"]\n    87\t    )\n    88\t    lora_dropout: float = 0.1\n    89\t    bias: str = \"none\"\n    90\t\n    91\t\n    92\t@dataclass\n    93\tclass ModelConfig:\n    94\t    \"\"\"\n    95\t    Full configuration for the HelioSpectFormer backbone and fine-tuning head.\n    96\t\n    97\t    Backbone parameters mirror the HelioSpectFormer constructor.\n    98\t    Fine-tuning head parameters are used by HelioSpectformer1D.\n    99\t    \"\"\"\n   100\t    # --- Backbone ---\n   101\t    img_size: int = 4096\n   102\t    patch_size: int = 16\n   103\t    in_channels: int = 13\n   104\t    embed_dim: int = 1280\n   105\t    depth: int = 10\n   106\t    spectral_blocks: int = 2\n   107\t    num_heads: int = 16\n   108\t    mlp_ratio: float = 4.0\n   109\t    drop_rate: float = 0.0\n   110\t    window_size: int = 2\n   111\t    dp_rank: int = 4\n   112\t    rpe: bool = False\n   113\t    learned_flow: bool = False\n   114\t    init_weights: bool = False\n   115\t    checkpoint_layers: List[int] = field(default_factory=lambda: list(range(10)))\n   116\t    ensemble: Optional[int] = None\n   117\t    time_embedding: TimeEmbeddingConfig = field(default_factory=TimeEmbeddingConfig)\n   118\t\n   119\t    # --- Fine-tuning head ---\n   120\t    # One of: \"global_average\" | \"global_max\" | \"attention\" | \"transformer\" | \"class_token\"\n   121\t    pooling: str = \"class_token\"\n   122\t    penultimate_linear_layer: bool = True\n   123\t    dropout: float = 0.2\n   124\t    freeze_backbone: bool = False\n   125\t\n   126\t    # --- LoRA ---\n   127\t    use_lora: bool = True\n   128\t    lora_config: LoraAdapterConfig = field(default_factory=LoraAdapterConfig)\n   129\t\n   130\t    # --- Checkpoint ---\n   131\t    # Path to the pretrained Surya backbone weights. Passed to load_pretrained_weights().\n   132\t    # Kept on ModelConfig (not TrainingConfig) because it describes the model, not the run.\n   133\t    pretrained_path: Optional[str] = None\n   134\t\n   135\t    def __post_init__(self) -> None:\n   136\t        if self.img_size % self.patch_size != 0:\n   137\t            raise ValueError(\n   138\t                f\"model.img_size ({self.img_size}) must be divisible by model.patch_size \"\n   139\t                f\"({self.patch_size}); patch embedding silently crops the remainder otherwise.\"\n   140\t            )\n   141\t        if not 0 <= self.spectral_blocks <= self.depth:\n   142\t            raise ValueError(\n   143\t                f\"model.spectral_blocks ({self.spectral_blocks}) must be between 0 and \"\n   144\t                f\"model.depth ({self.depth}) inclusive: spectral_blocks is the cutoff within \"\n   145\t                f\"the depth blocks, not an additional count.\"\n   146\t            )\n   147\t        bad_layers = [i for i in self.checkpoint_layers if not 0 <= i < self.depth]\n   148\t        if bad_layers:\n   149\t            raise ValueError(\n   150\t                f\"model.checkpoint_layers contains out-of-range index(es) {bad_layers}; \"\n   151\t                f\"each entry must satisfy 0 <= i < model.depth ({self.depth}). Out-of-range \"\n   152\t                \"entries are silently ignored at runtime rather than erroring, so they are \"\n   153\t                \"rejected here instead.\"\n   154\t            )\n   155\t        if self.learned_flow and self.time_embedding.type != \"linear\":\n   156\t            raise ValueError(\n   157\t                f\"model.learned_flow is only supported with model.time_embedding.type \"\n   158\t                f'\"linear\"; got type={self.time_embedding.type!r}. The vendored backbone\\'s '\n   159\t                \"\\\"linear\\\" embedding adjusts its channel count for the extra learned-flow \"\n   160\t                \"frame, but the other embedding types do not.\"\n   161\t            )\n   162\t\n   163\t\n   164\t# ---------------------------------------------------------------------------\n   165\t# Run configuration\n   166\t# ---------------------------------------------------------------------------\n   167\t\n   168\t@dataclass\n   169\tclass DataConfig:\n   170\t    \"\"\"What data to load, how to sample it in time, and how to reach it on S3.\n   171\t\n   172\t    Task-specific fields (label catalogs, alignment parameters, \u2026) do not belong here.\n   173\t    Subclass this in your app and pass the subclass to ``load_config(data_cls=...)``.\n   174\t    \"\"\"\n   175\t\n   176\t    # Fields holding a filesystem path. Relative values are resolved against the config\n   177\t    # file's own directory, so a checked-in config works from any working directory and\n   178\t    # on any machine \u2014 no absolute paths pointing into one user's home.\n   179\t    # A subclass that adds a path field must extend this, e.g.:\n   180\t    #     PATH_FIELDS = DataConfig.PATH_FIELDS + (\"my_catalog_path\",)\n   181\t    PATH_FIELDS: ClassVar[tuple[str, ...]] = (\n   182\t        \"train_data_path\",\n   183\t        \"valid_data_path\",\n   184\t        \"scalers_path\",\n   185\t        \"sdo_data_root_path\",\n   186\t    )\n   187\t\n   188\t    # --- Paths (relative paths are resolved against the config file's directory) ---\n   189\t    train_data_path: str\n   190\t    valid_data_path: str\n   191\t    scalers_path: str\n   192\t\n   193\t    # --- Input channels and temporal sampling ---\n   194\t    channels: List[str]\n   195\t    time_delta_input_minutes: List[int]\n   196\t    time_delta_target_minutes: int\n   197\t\n   198\t    # --- Local data ---\n   199\t    # Root prepended to relative local paths in the index. Ignored for s3:// paths.\n   200\t    sdo_data_root_path: Optional[str] = None\n   201\t\n   202\t    # --- S3 (used only when the index contains s3:// paths) ---\n   203\t    s3_anon: bool = False\n   204\t    # One of VALID_S3_MODES (above). \"download\" is recommended for NetCDF/HDF5.\n   205\t    s3_mode: str = \"download\"\n   206\t    # Required unless s3_mode is \"stream\". Budget ~1 GB per unique timestep.\n   207\t    # Left unset here, load_config() falls back to $SURYA_WS_CACHE_DIR.\n   208\t    s3_cache_dir: Optional[str] = None\n   209\t    s3_boto3_max_concurrency: int = 4   # parallel threads per multipart download\n   210\t    s3_boto3_part_size_mb: int = 64     # part size in MB for multipart downloads\n   211\t\n   212\t    # --- Development ---\n   213\t    max_samples: Optional[int] = None\n   214\t\n   215\t    def __post_init__(self) -> None:\n   216\t        if self.s3_mode not in VALID_S3_MODES:\n   217\t            raise ValueError(\n   218\t                f\"Unknown data.s3_mode {self.s3_mode!r}. \"\n   219\t                f\"Valid modes are: {', '.join(VALID_S3_MODES)}.\"\n   220\t            )\n   221\t\n   222\t\n   223\t@dataclass\n   224\tclass OutputConfig:\n   225\t    \"\"\"Paths and S3 settings for checkpoints and artifacts.\"\"\"\n   226\t    ckpt_dir: str = \"checkpoints\"\n   227\t    # S3 upload of best checkpoint (all three used together; leave s3_bucket null to disable)\n   228\t    s3_bucket: Optional[str] = None\n   229\t    s3_prefix: str = \"\"\n   230\t    s3_best_key: str = \"best.ckpt\"\n   231\t\n   232\t\n   233\t@dataclass\n   234\tclass TrainingConfig:\n   235\t    \"\"\"Top-level configuration for a fine-tuning run.\"\"\"\n   236\t    job_id: str\n   237\t    data: DataConfig\n   238\t    model: ModelConfig\n   239\t    output: OutputConfig = field(default_factory=OutputConfig)\n   240\t    learning_rate: float = 1e-4\n   241\t    max_epochs: int = 20\n   242\t    batch_size: int = 2\n   243\t    num_workers: int = 8\n   244\t    # Seeds every RNG (Python, NumPy, torch, and each DataLoader worker) and the shuffle\n   245\t    # order. This applies regardless of `deterministic`: even with determinism off, the\n   246\t    # data order is pinned, so changing the seed is how you get a genuinely different run.\n   247\t    seed: int = 42\n   248\t    # One of VALID_DETERMINISTIC (above). Defaults to False for speed; set \"warn\" when\n   249\t    # you need reproducible results.\n   250\t    deterministic: Union[bool, str] = False\n   251\t    rollout_steps: int = 0\n   252\t    drop_hmi_probability: float = 0.0\n   253\t    use_latitude_in_learned_flow: bool = False\n   254\t    dtype: str = \"float32\"\n   255\t    wandb_project: str = \"surya_downstream\"\n   256\t    wandb_entity: Optional[str] = None\n   257\t\n   258\t    def __post_init__(self) -> None:\n   259\t        # Normalize the string form so YAML \"Warn\"/\"WARN\" behave like \"warn\"; bools pass\n   260\t        # through untouched (YAML true/false already parse as Python bools).\n   261\t        if isinstance(self.deterministic, str):\n   262\t            self.deterministic = self.deterministic.lower()\n   263\t        if self.deterministic not in VALID_DETERMINISTIC:\n   264\t            raise ValueError(\n   265\t                f\"Unknown training.deterministic {self.deterministic!r}. \"\n   266\t                \"Valid values are: true, false, \\\"warn\\\".\"\n   267\t            )\n   268\t        # A quoted seed in YAML (\"42\") would otherwise reach torch.manual_seed as a str\n   269\t        # and fail deep in the training loop. bool is excluded because it subclasses int.\n   270\t        if isinstance(self.seed, bool) or not isinstance(self.seed, int):\n   271\t            raise ValueError(\n   272\t                f\"training.seed must be an integer, got {self.seed!r} \"\n   273\t                f\"({type(self.seed).__name__}). Write it unquoted in the YAML, e.g. seed: 42.\"\n   274\t            )\n   275\t        if self.deterministic is True and self.model.learned_flow:\n   276\t            raise ValueError(\n   277\t                \"training.deterministic: true is incompatible with model.learned_flow: true \"\n   278\t                \"(F.grid_sample has no deterministic CUDA backward). Use \"\n   279\t                'training.deterministic: \"warn\" instead, or set model.learned_flow: false.'\n   280\t            )\n   281\t        time_dim = self.model.time_embedding.time_dim\n   282\t        n_available = len(self.data.time_delta_input_minutes)\n   283\t        if time_dim > n_available:\n   284\t            raise ValueError(\n   285\t                f\"model.time_embedding.time_dim ({time_dim}) must be <= \"\n   286\t                f\"len(data.time_delta_input_minutes) ({n_available}): the dataset samples \"\n   287\t                \"time_dim frames from that list and cannot sample more than it contains.\"\n   288\t            )\n   289\t\n   290\t\n   291\t# ---------------------------------------------------------------------------\n   292\t# YAML parsing\n   293\t# ---------------------------------------------------------------------------\n   294\t\n   295\tdef _from_dict(cls, d: dict, section: str):\n   296\t    \"\"\"Construct a dataclass from a dict, rejecting unrecognized keys.\n   297\t\n   298\t    Unknown keys are an error, not a silent no-op. A dropped key looks exactly like a\n   299\t    working one: adding ``s3_mode: stream`` to the YAML without a matching dataclass\n   300\t    field would otherwise change nothing and report nothing. Failing here names the\n   301\t    typo and lists what was expected.\n   302\t    \"\"\"\n   303\t    if not isinstance(d, dict):\n   304\t        raise ValueError(f\"Config section '{section}:' must be a mapping, got {type(d).__name__}.\")\n   305\t\n   306\t    known = {f.name for f in dc_fields(cls)}\n   307\t    unknown = sorted(set(d) - known)\n   308\t    if unknown:\n   309\t        raise ValueError(\n   310\t            f\"Unrecognized key(s) in '{section}:' section of the config: \"\n   311\t            f\"{', '.join(unknown)}.\\n\"\n   312\t            f\"Valid keys for {cls.__name__} are: {', '.join(sorted(known))}.\\n\"\n   313\t            \"If this is a new task-specific setting, add it to your DataConfig subclass \"\n   314\t            \"(see downstream_apps/template/configs.py).\"\n   315\t        )\n   316\t\n   317\t    missing = [\n   318\t        f.name for f in dc_fields(cls)\n   319\t        if f.name not in d\n   320\t        and f.default is MISSING\n   321\t        and f.default_factory is MISSING  # type: ignore[misc]\n   322\t    ]\n   323\t    if missing:\n   324\t        raise ValueError(\n   325\t            f\"Missing required key(s) in '{section}:' section of the config: \"\n   326\t            f\"{', '.join(missing)}.\"\n   327\t        )\n   328\t\n   329\t    return cls(**d)\n   330\t\n   331\t\n   332\tdef _resolve_path(value, config_dir: Path) -> str:\n   333\t    \"\"\"Expand ``~``/``$VARS`` and anchor a relative path to the config file's directory.\"\"\"\n   334\t    expanded = os.path.expandvars(os.path.expanduser(str(value)))\n   335\t    if not os.path.isabs(expanded):\n   336\t        expanded = str((config_dir / expanded).resolve())\n   337\t    return expanded\n   338\t\n   339\t\n   340\tdef _resolve_paths(data_cfg, config_dir: Path) -> None:\n   341\t    \"\"\"Expand ``~``/env vars and resolve relative path fields against the config's directory.\"\"\"\n   342\t    for name in getattr(type(data_cfg), \"PATH_FIELDS\", DataConfig.PATH_FIELDS):\n   343\t        value = getattr(data_cfg, name, None)\n   344\t        if value:\n   345\t            setattr(data_cfg, name, _resolve_path(value, config_dir))\n   346\t\n   347\t    # s3_cache_dir is a scratch location, not a repo path. Precedence is\n   348\t    # CLI flag > config value > $SURYA_WS_CACHE_DIR; expand ~ and $VARS, but never anchor\n   349\t    # it to the config directory (that would put ~1 GB files inside the repo).\n   350\t    cache_dir = getattr(data_cfg, \"s3_cache_dir\", None) or os.environ.get(S3_CACHE_DIR_ENV_VAR)\n   351\t    if cache_dir:\n   352\t        data_cfg.s3_cache_dir = os.path.expandvars(os.path.expanduser(str(cache_dir)))\n   353\t\n   354\t\n   355\tdef load_config(\n   356\t    path: Union[str, Path],\n   357\t    data_cls: type = DataConfig,\n   358\t) -> TrainingConfig:\n   359\t    \"\"\"Parse a run config YAML into a typed ``TrainingConfig``.\n   360\t\n   361\t    The YAML has five top-level sections (data, model, training, output, logging) plus\n   362\t    ``job_id``. Each is parsed into its dataclass; unknown keys raise rather than being\n   363\t    silently dropped.\n   364\t\n   365\t    Args:\n   366\t        path: Path to the config YAML.\n   367\t        data_cls: The ``DataConfig`` subclass to parse the ``data:`` section into. Pass\n   368\t            your app's subclass to accept task-specific keys.\n   369\t\n   370\t    Returns:\n   371\t        A fully typed ``TrainingConfig``. Relative paths in the ``data:`` section are\n   372\t        resolved against the config file's own directory.\n   373\t    \"\"\"\n   374\t    config_path = Path(path).expanduser().resolve()\n   375\t    if not config_path.is_file():\n   376\t        raise FileNotFoundError(f\"Config file not found: {config_path}\")\n   377\t\n   378\t    with open(config_path, \"r\", encoding=\"utf-8\") as f:\n   379\t        raw = yaml.safe_load(f)\n   380\t\n   381\t    if not isinstance(raw, dict):\n   382\t        raise ValueError(f\"Config {config_path} must contain a top-level mapping.\")\n   383\t\n   384\t    missing_sections = [k for k in (\"job_id\", \"data\", \"model\") if k not in raw]\n   385\t    if missing_sections:\n   386\t        raise ValueError(\n   387\t            f\"Config {config_path} is missing required top-level key(s): \"\n   388\t            f\"{', '.join(missing_sections)}. Expected: job_id, data, model \"\n   389\t            \"(training, output and logging are optional).\"\n   390\t        )\n   391\t\n   392\t    # model: build the nested configs first, then the ModelConfig around them.\n   393\t    model_raw = dict(raw[\"model\"])\n   394\t    model_raw[\"time_embedding\"] = _from_dict(\n   395\t        TimeEmbeddingConfig, model_raw.get(\"time_embedding\", {}), \"model.time_embedding\"\n   396\t    )\n   397\t    model_raw[\"lora_config\"] = _from_dict(\n   398\t        LoraAdapterConfig, model_raw.get(\"lora_config\", {}), \"model.lora_config\"\n   399\t    )\n   400\t    model_cfg = _from_dict(ModelConfig, model_raw, \"model\")\n   401\t\n   402\t    # pretrained_path is a path like the data: ones, and gets the same treatment.\n   403\t    if model_cfg.pretrained_path:\n   404\t        model_cfg.pretrained_path = _resolve_path(model_cfg.pretrained_path, config_path.parent)\n   405\t\n   406\t    data_cfg = _from_dict(data_cls, raw[\"data\"], \"data\")\n   407\t    _resolve_paths(data_cfg, config_path.parent)\n   408\t\n   409\t    training = raw.get(\"training\", {}) or {}\n   410\t    logging_cfg = raw.get(\"logging\", {}) or {}\n   411\t    _check_section_keys(training, _TRAINING_KEYS, \"training\")\n   412\t    _check_section_keys(logging_cfg, _LOGGING_KEYS, \"logging\")\n   413\t\n   414\t    return TrainingConfig(\n   415\t        job_id=raw[\"job_id\"],\n   416\t        data=data_cfg,\n   417\t        model=model_cfg,\n   418\t        output=_from_dict(OutputConfig, raw.get(\"output\", {}) or {}, \"output\"),\n   419\t        learning_rate=training.get(\"learning_rate\", 1e-4),\n   420\t        max_epochs=training.get(\"max_epochs\", 20),\n   421\t        batch_size=training.get(\"batch_size\", 2),\n   422\t        num_workers=training.get(\"num_workers\", 8),\n   423\t        seed=training.get(\"seed\", 42),\n   424\t        deterministic=training.get(\"deterministic\", False),\n   425\t        rollout_steps=training.get(\"rollout_steps\", 0),\n   426\t        drop_hmi_probability=training.get(\"drop_hmi_probability\", 0.0),\n   427\t        use_latitude_in_learned_flow=training.get(\"use_latitude_in_learned_flow\", False),\n   428\t        dtype=training.get(\"dtype\", \"float32\"),\n   429\t        wandb_project=logging_cfg.get(\"wandb_project\", \"surya_downstream\"),\n   430\t        wandb_entity=logging_cfg.get(\"wandb_entity\"),\n   431\t    )\n   432\t\n   433\t\n   434\t# The training: and logging: sections map onto flat TrainingConfig fields rather than\n   435\t# onto a dataclass of their own, so their keys are checked explicitly.\n   436\t_TRAINING_KEYS = frozenset({\n   437\t    \"learning_rate\", \"max_epochs\", \"batch_size\", \"num_workers\", \"seed\", \"deterministic\",\n   438\t    \"rollout_steps\", \"drop_hmi_probability\", \"use_latitude_in_learned_flow\", \"dtype\",\n   439\t})\n   440\t_LOGGING_KEYS = frozenset({\"wandb_project\", \"wandb_entity\"})\n   441\t\n   442\t\n   443\tdef _check_section_keys(section: dict, valid: frozenset, name: str) -> None:\n   444\t    \"\"\"Raise on unrecognized keys in a section that has no dataclass of its own.\"\"\"\n   445\t    unknown = sorted(set(section) - valid)\n   446\t    if unknown:\n   447\t        raise ValueError(\n   448\t            f\"Unrecognized key(s) in '{name}:' section of the config: {', '.join(unknown)}.\\n\"\n   449\t            f\"Valid keys are: {', '.join(sorted(valid))}.\"\n   450\t        )",
            "title": "cat -n configs.py",
            "permission_options": [
              {
                "kind": "allow_once",
                "name": "Yes",
