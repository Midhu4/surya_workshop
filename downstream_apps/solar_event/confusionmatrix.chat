            "title": "Read metrics/template_metrics.py",
            "raw_output": "1\t\"\"\"\n2\tTemplate metrics for solar event identification.\n3\t\n4\tSolarEventMetrics defines four metric sets:\n5\t- \"train_loss\"    \u2014 differentiable loss that drives backpropagation (Binary Cross Entropy).\n6\t- \"val_loss\"      \u2014 the quantity logged as `val_loss` and used to select checkpoints.\n7\t                    Defaults to the same Binary Cross Entropy as \"train_loss\"; override it when your task\n8\t                    needs a different validation objective.\n9\t- \"train_metrics\" \u2014 non-differentiable metrics logged during training (Binary Accuracy).\n10\t- \"val_metrics\"   \u2014 metrics logged at validation for reporting only (Binary Cross Entropy + Binary Accuracy). These\n11\t                    do NOT influence checkpoint selection \u2014 \"val_loss\" does.\n12\t\n13\tThe __call__ method selects the appropriate metric set based on the mode passed at\n14\tconstruction time. The dictionary keys returned by each method become the metric names\n15\tpropagated to the logger (e.g. WandB, CSV).\n16\t\"\"\"\n17\t\n18\timport torch\n19\timport torchmetrics as tm  # Lots of possible metrics in here https://lightning.ai/docs/torchmetrics/stable/all-metrics.html\n20\t\n21\t# Shape contract: predictions arrive as (B,) from HelioSpectformer1D or (B, 1) from the\n22\t# linear baseline, while targets are always (B, 1). Every metric below flattens both with\n23\t# reshape(-1) rather than squeeze(-1): squeeze is shape-dependent and collapses a\n24\t# batch of one to a 0-d scalar, which then fails to broadcast against a (1,) target.\n25\tclass SolarEventMetrics:\n26\t    def __init__(self, mode: str):\n27\t        \"\"\"\n28\t        Initialize SolarEventMetrics class.\n29\t\n30\t        Args:\n31\t            mode (str): Mode to use for metric evaluation. One of \"train_loss\",\n32\t                        \"val_loss\", \"train_metrics\", or \"val_metrics\".\n33\t        \"\"\"\n34\t        self.mode = mode\n35\t\n36\t        # Cache torchmetrics instances once (instead of recreating each call)\n37\t        # Using binary accuracy since we deal with binary classification data\n38\t        self.BinaryAccuracy = tm.classification.BinaryAccuracy(threshold=0.5)\n39\t\n40\t    def _ensure_device(self, preds: torch.Tensor) -> None:\n41\t        \"\"\"Move torchmetrics modules to the same device as ``preds``, if needed.\"\"\"\n42\t        if self.BinaryAccuracy.device != preds.device:\n43\t            self.BinaryAccuracy = self.BinaryAccuracy.to(preds.device)\n44\t\n45\t    def train_loss(\n46\t        self, preds: torch.Tensor, target: torch.Tensor\n47\t    ) -> tuple[dict[str, torch.Tensor], list[float]]:\n48\t        \"\"\"\n49\t        Calculate loss metrics for training.\n50\t\n51\t        Args:\n52\t            preds (torch.Tensor): Model predictions.\n53\t            target (torch.Tensor): Ground truth labels.\n54\t\n55\t        Returns:\n56\t            tuple[dict[str, torch.Tensor], list[float]]:\n57\t                - dict[str, torch.Tensor]: Dictionary containing the calculated loss metrics.\n58\t                                        Keys are metric names (e.g., \"Binary Cross Entropy\"), and values are the\n59\t                                        corresponding torch.Tensor values.\n60\t                - list[float]: List of weights for each calculated metric.\n61\t        \"\"\"\n62\t\n63\t        output_metrics = {}\n64\t        output_weights = []\n65\t\n66\t        output_metrics[\"binary_cross_entropy\"] = torch.nn.functional.binary_cross_entropy_with_logits(preds.reshape(-1), target.reshape(-1))\n67\t        output_weights.append(1)\n68\t\n69\t        return output_metrics, output_weights\n70\t\n71\t    def val_loss(\n72\t        self, preds: torch.Tensor, target: torch.Tensor\n73\t    ) -> tuple[dict[str, torch.Tensor], list[float]]:\n74\t        \"\"\"\n75\t        Calculate the validation loss \u2014 the quantity logged as ``val_loss`` and used by\n76\t        ModelCheckpoint to select the best model.\n77\t\n78\t        By default this delegates to ``train_loss``, so the monitored quantity has the same\n79\t        form as the training objective and the two cannot drift apart by accident. This is\n80\t        the hook to override when your task needs a different validation objective (a\n81\t        different weighting, a metric that is meaningful only on held-out data, etc.).\n82\t\n83\t        Note that this is deliberately separate from ``val_metrics``: those are reported\n84\t        for information only and do not affect checkpoint selection.\n85\t\n86\t        Args:\n87\t            preds (torch.Tensor): Model predictions.\n88\t            target (torch.Tensor): Ground truth labels.\n89\t\n90\t        Returns:\n91\t            tuple[dict[str, torch.Tensor], list[float]]:\n92\t                - dict[str, torch.Tensor]: Dictionary containing the calculated loss metrics.\n93\t                - list[float]: List of weights for each calculated metric.\n94\t        \"\"\"\n95\t        return self.train_loss(preds, target)\n96\t\n97\t    def train_metrics(\n98\t        self, preds: torch.Tensor, target: torch.Tensor\n99\t    ) -> tuple[dict[str, torch.Tensor], list[float]]:\n100\t        \"\"\"\n101\t        Calculate evaluation metrics for training.\n102\t        IMPORTANT:  These metrics are only for reporting purposes and do not\n103\t                    contribute to the training loss. Use only if you want to\n104\t                    monitor additional metrics during training.\n105\t\n106\t        Args:\n107\t            preds (torch.Tensor): Model predictions.\n108\t            target (torch.Tensor): Ground truth labels.\n109\t\n110\t        Returns:\n111\t            tuple[dict[str, torch.Tensor], list[float]]:\n112\t                - dict[str, torch.Tensor]: Dictionary containing the calculated evaluation metrics.\n113\t                                        Keys are metric names, and values are the corresponding torch.Tensor values.\n114\t                - list[float]: List of weights for each calculated metric.\n115\t        \"\"\"\n116\t        output_metrics = {}\n117\t        output_weights = []\n118\t\n119\t        self._ensure_device(preds)\n120\t        output_metrics[\"BinaryAccuracy\"] = self.BinaryAccuracy(preds.reshape(-1).sigmoid(), target.reshape(-1))\n121\t        output_weights.append(1)        \n122\t\n123\t\n124\t        return output_metrics, output_weights\n125\t\n126\t    def val_metrics(\n127\t        self, preds: torch.Tensor, target: torch.Tensor\n128\t    ) -> tuple[dict[str, torch.Tensor], list[float]]:\n129\t        \"\"\"\n130\t        Calculate metrics for validation.\n131\t\n132\t        Args:\n133\t            preds (torch.Tensor): Model predictions.\n134\t            target (torch.Tensor): Ground truth labels.\n135\t\n136\t        Returns:\n137\t            tuple[dict[str, torch.Tensor], list[float]]:\n138\t                - dict[str, torch.Tensor]: Dictionary containing the calculated metrics.\n139\t                                        Keys are metric names (e.g., \"Binary Cross Entropy\"), and values are the\n140\t                                        corresponding torch.Tensor values.\n141\t                - list[float]: List of weights for each calculated metric.\n142\t        \"\"\"\n143\t\n144\t        output_metrics = {}\n145\t        output_weights = []\n146\t\n147\t        output_metrics[\"binary_cross_entropy\"] = torch.nn.functional.binary_cross_entropy_with_logits(preds.reshape(-1), target.reshape(-1))\n148\t        output_weights.append(1)\n149\t\n150\t        self._ensure_device(preds)\n151\t        output_metrics[\"BinaryAccuracy\"] = self.BinaryAccuracy(preds.reshape(-1).sigmoid(), target.reshape(-1))\n152\t        output_weights.append(1)\n153\t\n154\t        return output_metrics, output_weights\n155\t\n156\t    def __call__(\n157\t        self, preds: torch.Tensor, target: torch.Tensor\n158\t    ) -> tuple[dict[str, torch.Tensor], list[float]]:\n159\t        \"\"\"Evaluate metrics for the mode set at construction time.\n160\t\n161\t        Args:\n162\t            preds: Model output tensor. Shape depends on the application.\n163\t            target: Ground truth tensor to compare against.\n164\t\n165\t        Returns:\n166\t            tuple[dict[str, torch.Tensor], list[float]]:\n167\t                - Metric dictionary. Keys become logger metric names; values are\n168\t                  scalar tensors aggregated over the batch.\n169\t                - List of per-metric weights (used by SolarEventLightningModule to\n170\t                  combine multiple loss terms into a single scalar).\n171\t        \"\"\"\n172\t\n173\t        match self.mode.lower():\n174\t\n175\t            case \"train_loss\":\n176\t                return self.train_loss(preds, target)\n177\t\n178\t            # No torch.no_grad() here, matching \"train_loss\": Lightning already disables\n179\t            # gradients during validation, so wrapping it would differ gratuitously from\n180\t            # the loss case this mirrors.\n181\t            case \"val_loss\":\n182\t                return self.val_loss(preds, target)\n183\t\n184\t            case \"train_metrics\":\n185\t                with torch.no_grad():\n186\t                    return self.train_metrics(preds, target)\n187\t\n188\t            case \"val_metrics\":\n189\t                with torch.no_grad():\n190\t                    return self.val_metrics(preds, target)\n191\t\n192\t            case _:\n193\t                raise NotImplementedError(\n194\t                    f\"{self.mode} is not implemented as a valid metric case.\"\n195\t                )\n196\t"
          },
