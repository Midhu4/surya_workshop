            "raw_output": "{\"result\":[{\"cellType\":\"code\",\"source\":\"all_probs = []\\nall_targets = []\\n\\nwith torch.no_grad():\\n    for batch in val_loader:\\n        target = batch[\\\"forecast\\\"].reshape(-1).float()\\n        batch = {k: (v.to(device) if torch.is_tensor(v) else v) for k, v in batch.items()}\\n        if lit_model.preprocess_fn is not None:\\n            batch = lit_model.preprocess_fn(batch)\\n\\n        logits = lit_model(batch)\\n        probs = logits.reshape(-1).sigmoid().cpu()\\n\\n        all_probs.append(probs)\\n        all_targets.append(target)\\n\\ny_prob = torch.cat(all_probs).numpy()\\ny_true = torch.cat(all_targets).numpy().astype(int)\\nprint(f\\\"Evaluated {len(y_true)} validation samples | positive rate: {y_true.mean():.3f}\\\")\",\"execution_count\":5,\"cell_id\":\"65f4fc39-aa75-4541-a53f-b176c8ee8759\",\"language\":\"python\"}]}",
